---
import "../styles/global.css";
import CommandPalette from "@/components/CommandPalette.astro";
import { getCollection, getEntry } from "astro:content";
import { ClientRouter } from "astro:transitions";
import { getPosts, postHref } from "@/lib/posts";
import { canonicalUrl, serializeJsonLd, siteDescription, siteImage } from "@/lib/seo";
import { starsGroups, starsListHref, starsListName } from "@/lib/stars";

interface Props {
  home?: boolean;
  motion?: "full" | "subtle" | "static";
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article" | "profile";
  pageType?: "WebPage" | "ProfilePage";
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  publishedTime?: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  home = false,
  motion,
  title,
  description,
  image = siteImage,
  imageAlt = "Enguerrand Allamel speaking at a cloud-native conference",
  imageWidth,
  imageHeight,
  publishedTime,
  pageType = "WebPage",
  type = "website",
  noindex = false,
  structuredData,
} = Astro.props;
const pageMotion = motion ?? (home ? "full" : "subtle");
const pageDescription = description ?? siteDescription;
const pageTitle = title ? `${title} | Enguerrand Allamel` : "Enguerrand Allamel | Platform Security Engineer";
const siteUrl = Astro.site ?? new URL("https://enguerrand.dev");
const pageUrl = canonicalUrl(Astro.url.pathname, siteUrl);
const ogImageUrl = new URL(image, siteUrl).toString();
const ogImageWidth = imageWidth ?? (image === siteImage ? 1536 : undefined);
const ogImageHeight = imageHeight ?? (image === siteImage ? 1536 : undefined);
const defaultStructuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": new URL("/#person", siteUrl).toString(),
      name: "Enguerrand Allamel",
      url: siteUrl.toString(),
      image: new URL("/avatar.webp", siteUrl).toString(),
      jobTitle: "Senior Platform Security Engineer",
      address: {
        "@type": "PostalAddress",
        addressLocality: "Vancouver",
        addressRegion: "BC",
        addressCountry: "CA",
      },
      sameAs: [
        "https://github.com/AEnguerrand",
        "https://www.linkedin.com/in/enguerrandallamel/",
      ],
      knowsAbout: [
        "AI development security",
        "Cloud security",
        "Software supply chain security",
        "Kubernetes",
        "Site reliability engineering",
        "AWS",
        "SLSA",
        "Sigstore",
      ],
    },
    {
      "@type": "WebSite",
      "@id": new URL("/#website", siteUrl).toString(),
      url: siteUrl.toString(),
      name: "Enguerrand Allamel",
      description: siteDescription,
      inLanguage: "en",
      author: { "@id": new URL("/#person", siteUrl).toString() },
    },
    {
      "@type": pageType,
      "@id": `${pageUrl}#webpage`,
      url: pageUrl,
      name: pageTitle,
      description: pageDescription,
      inLanguage: "en",
      isPartOf: { "@id": new URL("/#website", siteUrl).toString() },
      primaryImageOfPage: { "@type": "ImageObject", url: ogImageUrl },
      ...(pageType === "ProfilePage" ? { mainEntity: { "@id": new URL("/#person", siteUrl).toString() } } : {}),
      ...(type === "article" ? { mainEntity: { "@id": `${pageUrl}#article` } } : {}),
    },
  ],
};
const extraStructuredData = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];
const jsonLd = {
  ...defaultStructuredData,
  "@graph": [...defaultStructuredData["@graph"], ...extraStructuredData],
};
const [talks, posts, homePage] = await Promise.all([
  getCollection("talks"),
  getPosts(),
  getEntry("pages", "home"),
]);
const commandItems = [
  { id: "page-home", title: "Home", href: "/", kind: "Page", keywords: "Enguerrand Allamel platform security" },
  { id: "page-talks", title: "Talks", href: "/talks/", kind: "Page", keywords: "conference workshops videos slides" },
  { id: "page-projects", title: "Projects", href: "/projects/", kind: "Page", keywords: "software open source" },
  { id: "page-radar", title: "Radar", href: "/radar/", kind: "Page", keywords: "technical library github stars" },
  { id: "page-blog", title: "Blog", href: "/blog/", kind: "Page", keywords: "articles field notes" },
  { id: "page-about", title: "About", href: "/about/", kind: "Page", keywords: "Enguerrand Allamel biography" },
  { id: "page-resume", title: "Resume", href: "/resume/", kind: "Page", keywords: "experience work cv" },
  { id: "page-stars", title: "All Radar topics", href: "/github-stars/", kind: "Page", keywords: "repositories technical resources bookmarks" },
  { id: "page-topics", title: "Topics", href: "/topics/", kind: "Page", keywords: "talk subjects tags" },
  { id: "page-search", title: "Full search", href: "/search/", kind: "Page", keywords: "site search" },
  { id: "page-privacy", title: "Privacy", href: "/privacy/", kind: "Page", keywords: "analytics data" },
  ...(homePage?.data.projects ?? []).map((project, index) => ({
    id: `project-${index}`,
    title: project.title,
    href: project.url,
    kind: "Project",
    keywords: `${project.description} ${project.status}`,
  })),
  ...talks.map((talk) => ({
    id: `talk-${talk.id}`,
    title: talk.data.displayTitle ?? talk.data.title,
    href: `/talks/${talk.id}/`,
    kind: "Talk",
    keywords: [talk.data.title, talk.data.event, talk.data.summary, ...(talk.data.tags ?? [])].filter(Boolean).join(" "),
  })),
  ...posts.map((post) => ({
    id: `post-${post.id}`,
    title: post.data.title,
    href: postHref(post.id),
    kind: "Post",
    keywords: `${post.data.description} ${post.data.tags.join(" ")}`,
  })),
  ...starsGroups.map((group) => ({
    id: `stars-${group.slug}`,
    title: starsListName(group.name),
    href: starsListHref(group.slug),
    kind: "Radar topic",
    keywords: `${group.description ?? ""} ${group.slug.replaceAll("-", " ")}`,
  })),
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <meta name="author" content="Enguerrand Allamel" />
    <meta
      name="robots"
      content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
    />
    <title>{pageTitle}</title>
    <link rel="canonical" href={pageUrl} />

    <meta property="og:type" content={type} />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:site_name" content="Enguerrand Allamel" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={imageAlt} />

    {ogImageWidth && <meta property="og:image:width" content={ogImageWidth} />}
    {ogImageHeight && <meta property="og:image:height" content={ogImageHeight} />}
    {type === "article" && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {type === "article" && <meta property="article:author" content={siteUrl.toString()} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <meta name="theme-color" content="#f6f4ef" />

    <script type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <ClientRouter fallback="swap" />
  </head>
  <body transition:animate="none" data-motion={pageMotion} class:list={["min-h-screen bg-background font-sans text-foreground antialiased", { "home-page": home }]}>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <div class="site-page relative isolate min-h-screen">
      <header transition:persist="site-header" class="site-header site-shell">
        <nav class="site-nav" aria-label="Main navigation" data-site-nav>
          <a class="site-brand" href="/" aria-current={Astro.url.pathname === "/" ? "page" : undefined}>Enguerrand Allamel</a>
          <button
            class="site-nav-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="site-nav-links"
            aria-label="Open navigation"
            data-site-nav-toggle
          >
            <span class="site-nav-toggle-line" aria-hidden="true"></span>
            <span class="site-nav-toggle-line" aria-hidden="true"></span>
          </button>
          <div id="site-nav-links" class="site-nav-links" data-site-nav-links>
            <a href="/talks/" aria-current={Astro.url.pathname.startsWith("/talks/") ? "page" : undefined}>Talks</a>
            {posts.length > 0 && <a href="/blog/" aria-current={Astro.url.pathname.startsWith("/blog/") ? "page" : undefined}>Blog</a>}
            <a href="/projects/" aria-current={Astro.url.pathname.startsWith("/projects/") ? "page" : undefined}>Projects</a>
            <a href="/radar/" aria-current={Astro.url.pathname.startsWith("/radar/") ? "page" : undefined}>Radar</a>
            <a href="/about/" aria-current={Astro.url.pathname.startsWith("/about/") || Astro.url.pathname.startsWith("/resume/") ? "page" : undefined}>About</a>
          </div>
          <span class="site-nav-indicator" aria-hidden="true" data-site-nav-indicator></span>
        </nav>
      </header>

      <main class="site-main site-shell">
        <span id="main-content" tabindex="-1" class="skip-target" aria-label="Main content"></span>
        <slot />
      </main>

      <footer class="site-footer site-shell">
        <div class="site-footer-message">
          <p class="site-footer-kicker">Based in Vancouver, BC, Canada <span aria-hidden="true">🇨🇦</span></p>
        </div>
        <div class="site-footer-bottom">
          <a class="site-footer-email" href="mailto:hello@enguerrand.dev">hello@enguerrand.dev</a>
          <div class="site-footer-links">
            <a href="/github-stars/">Radar topics</a>
            <a href="/topics/">Topics</a>
            <a href="/radar/">Radar</a>
            <a href="/search/">Search</a>
            <a href="/privacy/">Privacy</a>
          </div>
        </div>
      </footer>
    </div>
    <CommandPalette items={commandItems} />
    <script is:inline>
      (() => {
        const initializeSiteShell = () => {
        window.__siteShellController?.abort();
        const siteShellController = new AbortController();
        window.__siteShellController = siteShellController;

        window.__siteRevealObserver?.disconnect();

        const currentPath = window.location.pathname;
        document.querySelectorAll(".site-nav a").forEach((link) => {
          const linkPath = new URL(link.href, window.location.origin).pathname;
          const isCurrent = linkPath === "/"
            ? currentPath === "/"
            : linkPath === "/about/"
              ? currentPath.startsWith("/about/") || currentPath.startsWith("/resume/")
              : currentPath.startsWith(linkPath);

          if (isCurrent) {
            link.setAttribute("aria-current", "page");
          } else {
            link.removeAttribute("aria-current");
          }
        });

        const nav = document.querySelector("[data-site-nav]");
        const navToggle = document.querySelector("[data-site-nav-toggle]");
        const navLinks = document.querySelector("[data-site-nav-links]");
        const navIndicator = document.querySelector("[data-site-nav-indicator]");
        const mobileNavigation = window.matchMedia("(max-width: 767px)");

        const syncNavIndicator = () => {
          if (!(nav instanceof HTMLElement) || !(navIndicator instanceof HTMLElement) || mobileNavigation.matches) {
            navIndicator?.removeAttribute("data-ready");
            return;
          }

          const currentLink = nav.querySelector('a[aria-current="page"]');
          if (!(currentLink instanceof HTMLElement)) return;
          const indicatorWidth = 24;
          navIndicator.style.setProperty("--nav-indicator-x", `${currentLink.offsetLeft + (currentLink.offsetWidth - indicatorWidth) / 2}px`);
          navIndicator.setAttribute("data-ready", "");
        };

        const setNavigationOpen = (open) => {
          if (!(nav instanceof HTMLElement) || !(navToggle instanceof HTMLButtonElement) || !(navLinks instanceof HTMLElement)) {
            return;
          }

          nav.toggleAttribute("data-open", open);
          navToggle.setAttribute("aria-expanded", String(open));
          navToggle.setAttribute("aria-label", open ? "Close navigation" : "Open navigation");
          document.body.classList.toggle("site-navigation-open", open);
          navLinks.inert = mobileNavigation.matches && !open;
        };

        const syncNavigationMode = () => {
          if (!mobileNavigation.matches) {
            setNavigationOpen(false);
            if (navLinks instanceof HTMLElement) navLinks.inert = false;
            return;
          }

          setNavigationOpen(false);
        };

        if (navToggle instanceof HTMLButtonElement && nav instanceof HTMLElement) {
          navToggle.addEventListener("click", () => {
            setNavigationOpen(!nav.hasAttribute("data-open"));
          }, { signal: siteShellController.signal });
        }

        navLinks?.addEventListener("click", (event) => {
          if (event.target instanceof HTMLAnchorElement) setNavigationOpen(false);
        }, { signal: siteShellController.signal });
        mobileNavigation.addEventListener("change", syncNavigationMode, { signal: siteShellController.signal });
        window.addEventListener("resize", syncNavIndicator, { signal: siteShellController.signal });
        syncNavigationMode();
        window.requestAnimationFrame(syncNavIndicator);

        document.querySelectorAll("[data-reveal-group]").forEach((group) => {
          group.querySelectorAll("[data-reveal-item]").forEach((item, index) => {
            if (item instanceof HTMLElement) item.style.setProperty("--reveal-index", String(index));
          });
        });

        const hero = document.querySelector("[data-hero-motion]");
        if (hero instanceof HTMLElement) {
          window.requestAnimationFrame(() => hero.classList.add("is-visible"));
        }

        const motionMode = document.body.dataset.motion ?? "subtle";
        if (motionMode !== "static") {
          document.querySelectorAll(".site-page-header, .site-main > .site-section-divider").forEach((item) => {
            item.setAttribute("data-reveal", "");
          });
        }
        const revealItems = Array.from(document.querySelectorAll("[data-reveal]"));
        if (motionMode === "static" || window.matchMedia("(prefers-reduced-motion: reduce)").matches || !("IntersectionObserver" in window)) {
          revealItems.forEach((item) => item.classList.add("is-visible"));
        } else {
          const revealObserver = new IntersectionObserver((entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add("is-visible");
              revealObserver.unobserve(entry.target);
            }
          }, { threshold: 0.05, rootMargin: "0px 0px -4% 0px" });
          revealItems.forEach((item) => revealObserver.observe(item));
          window.__siteRevealObserver = revealObserver;
        }

        window.__siteStoryObserver?.disconnect();
        const storyItems = Array.from(document.querySelectorAll("[data-motion-story]"));
        if (motionMode === "static" || window.matchMedia("(prefers-reduced-motion: reduce)").matches || !("IntersectionObserver" in window)) {
          storyItems.forEach((item) => item.removeAttribute("data-motion-active"));
        } else {
          const storyObserver = new IntersectionObserver((entries) => {
            for (const entry of entries) {
              entry.target.toggleAttribute("data-motion-active", entry.isIntersecting);
            }
          }, { threshold: 0.2 });
          storyItems.forEach((item) => storyObserver.observe(item));
          window.__siteStoryObserver = storyObserver;
        }

        const isEditableTarget = (target) => {
          if (!(target instanceof HTMLElement)) {
            return false;
          }

          const tag = target.tagName;
          return (
            target.isContentEditable ||
            tag === "INPUT" ||
            tag === "TEXTAREA" ||
            tag === "SELECT"
          );
        };

        const secretSequence = ["arrowleft", "arrowleft", "arrowup", "b", "s"];
        let secretSequenceProgress = 0;

        const launchConfettiBurst = ({
          xRatio = 0.5,
          yRatio = 0.45,
          particleCount = 120,
        } = {}) => {
          const canvas = document.createElement("canvas");
          canvas.setAttribute("aria-hidden", "true");
          canvas.className = "site-confetti";
          document.body.appendChild(canvas);

          const context = canvas.getContext("2d");
          if (!context) {
            canvas.remove();
            return;
          }

          const dpr = Math.max(1, window.devicePixelRatio || 1);
          const width = window.innerWidth;
          const height = window.innerHeight;
          canvas.width = Math.floor(width * dpr);
          canvas.height = Math.floor(height * dpr);
          context.scale(dpr, dpr);

          const originX = width * xRatio;
          const originY = height * yRatio;
          const rootStyles = window.getComputedStyle(document.documentElement);
          const particleColors = [
            `hsl(${rootStyles.getPropertyValue("--primary")})`,
            `hsl(${rootStyles.getPropertyValue("--accent")})`,
            `hsl(${rootStyles.getPropertyValue("--foreground")})`,
          ];
          const particleLifetimeMs = 1400;
          const gravity = 0.18;
          const drag = 0.986;

          const particles = Array.from({ length: particleCount }, () => {
            const angle = Math.random() * Math.PI * 2;
            const speed = 4 + Math.random() * 8;
            return {
              x: originX,
              y: originY,
              vx: Math.cos(angle) * speed,
              vy: Math.sin(angle) * speed - (4 + Math.random() * 3),
              size: 4 + Math.random() * 5,
              rotation: Math.random() * Math.PI * 2,
              rotationVelocity: (Math.random() - 0.5) * 0.35,
              color: particleColors[Math.floor(Math.random() * particleColors.length)],
            };
          });

          const startTime = performance.now();
          let previousTimestamp = startTime;

          const frame = (timestamp) => {
            const elapsed = timestamp - startTime;
            const normalizedDelta = Math.min(
              2,
              (timestamp - previousTimestamp) / 16.67,
            );
            previousTimestamp = timestamp;

            context.clearRect(0, 0, width, height);

            const fade = 1 - elapsed / particleLifetimeMs;
            for (const particle of particles) {
              particle.vx *= Math.pow(drag, normalizedDelta);
              particle.vy += gravity * normalizedDelta;
              particle.x += particle.vx * normalizedDelta;
              particle.y += particle.vy * normalizedDelta;
              particle.rotation += particle.rotationVelocity * normalizedDelta;

              context.save();
              context.translate(particle.x, particle.y);
              context.rotate(particle.rotation);
              context.globalAlpha = Math.max(0, fade);
              context.fillStyle = particle.color;
              context.fillRect(
                -particle.size / 2,
                -particle.size / 2,
                particle.size,
                particle.size * 0.55,
              );
              context.restore();
            }

            if (elapsed < particleLifetimeMs) {
              window.requestAnimationFrame(frame);
            } else {
              canvas.remove();
            }
          };

          window.requestAnimationFrame(frame);
        };

        const triggerConfetti = () => {
          if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
            return;
          }

          launchConfettiBurst();
          window.setTimeout(() => {
            launchConfettiBurst({ xRatio: 0.34, yRatio: 0.56, particleCount: 80 });
          }, 120);
          window.setTimeout(() => {
            launchConfettiBurst({ xRatio: 0.66, yRatio: 0.56, particleCount: 80 });
          }, 230);
        };

        document.querySelectorAll("[data-confetti-trigger]").forEach((trigger) => {
          trigger.addEventListener("click", () => {
            if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
            const bounds = trigger.getBoundingClientRect();
            launchConfettiBurst({
              xRatio: (bounds.left + bounds.width / 2) / window.innerWidth,
              yRatio: (bounds.top + bounds.height / 2) / window.innerHeight,
              particleCount: 90,
            });
          }, { signal: siteShellController.signal });
        });

        const updateSecretSequence = (event) => {
          if (isEditableTarget(event.target)) {
            secretSequenceProgress = 0;
            return false;
          }

          if (event.ctrlKey || event.metaKey || event.altKey) {
            secretSequenceProgress = 0;
            return false;
          }

          const key = event.key.toLowerCase();
          if (key === secretSequence[secretSequenceProgress]) {
            secretSequenceProgress += 1;

            if (secretSequenceProgress === secretSequence.length) {
              secretSequenceProgress = 0;
              triggerConfetti();
              return true;
            }

            return false;
          }

          secretSequenceProgress = key === secretSequence[0] ? 1 : 0;
          return false;
        };

        window.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && nav instanceof HTMLElement && nav.hasAttribute("data-open")) {
            event.preventDefault();
            setNavigationOpen(false);
            navToggle?.focus();
            return;
          }

          if (updateSecretSequence(event)) {
            event.preventDefault();
            return;
          }

          if (!(event.metaKey || event.ctrlKey)) {
            return;
          }

          if (event.key.toLowerCase() !== "k") {
            return;
          }

          if (isEditableTarget(event.target)) {
            return;
          }

          event.preventDefault();

          window.dispatchEvent(new CustomEvent("site-command:open"));
        }, { signal: siteShellController.signal });
        };

        if (!window.__siteShellPageLoadBound) {
          document.addEventListener("astro:page-load", initializeSiteShell);
          window.__siteShellPageLoadBound = true;
        }
        initializeSiteShell();
      })();
    </script>
  </body>
</html>
