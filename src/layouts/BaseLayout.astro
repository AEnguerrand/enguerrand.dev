---
import "../styles/global.css";
import "../styles/interiors.css";
import siteShellUrl from "@/scripts/site-shell.js?url";
import HarbourFooter from "@/components/HarbourFooter.astro";
import CommandPalette from "@/components/CommandPalette.astro";
import { getSearchItems, searchLabels } from "@/lib/site-search";
import { ClientRouter } from "astro:transitions";
import { canonicalUrl, serializeJsonLd, siteDescription, siteImage } from "@/lib/seo";

interface Props {
  home?: boolean;
  motion?: "full" | "subtle" | "static";
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article" | "profile";
  pageType?: "WebPage" | "ProfilePage";
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  publishedTime?: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  home = false,
  motion,
  title,
  description,
  image = siteImage,
  imageAlt = "Enguerrand Allamel speaking at a cloud-native conference",
  imageWidth,
  imageHeight,
  publishedTime,
  pageType = "WebPage",
  type = "website",
  noindex = false,
  structuredData,
} = Astro.props;
const pageMotion = motion ?? (home ? "full" : "subtle");
const pageDescription = description ?? siteDescription;
const pageTitle = title ? `${title} | Enguerrand Allamel` : "Enguerrand Allamel | Platform Security Engineer";
const siteUrl = Astro.site ?? new URL("https://enguerrand.dev");
const pageUrl = canonicalUrl(Astro.url.pathname, siteUrl);
const ogImageUrl = new URL(image, siteUrl).toString();
const ogImageWidth = imageWidth ?? (image === siteImage ? 1536 : undefined);
const ogImageHeight = imageHeight ?? (image === siteImage ? 1536 : undefined);
const defaultStructuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": new URL("/#person", siteUrl).toString(),
      name: "Enguerrand Allamel",
      url: siteUrl.toString(),
      image: new URL("/avatar.webp", siteUrl).toString(),
      jobTitle: "Senior Platform Security Engineer",
      address: {
        "@type": "PostalAddress",
        addressLocality: "Vancouver",
        addressRegion: "BC",
        addressCountry: "CA",
      },
      sameAs: [
        "https://github.com/AEnguerrand",
        "https://www.linkedin.com/in/enguerrandallamel/",
      ],
      knowsAbout: [
        "AI development security",
        "Cloud security",
        "Software supply chain security",
        "Kubernetes",
        "Site reliability engineering",
        "AWS",
        "SLSA",
        "Sigstore",
      ],
    },
    {
      "@type": "WebSite",
      "@id": new URL("/#website", siteUrl).toString(),
      url: siteUrl.toString(),
      name: "Enguerrand Allamel",
      description: siteDescription,
      inLanguage: "en",
      author: { "@id": new URL("/#person", siteUrl).toString() },
    },
    {
      "@type": pageType,
      "@id": `${pageUrl}#webpage`,
      url: pageUrl,
      name: pageTitle,
      description: pageDescription,
      inLanguage: "en",
      isPartOf: { "@id": new URL("/#website", siteUrl).toString() },
      primaryImageOfPage: { "@type": "ImageObject", url: ogImageUrl },
      ...(pageType === "ProfilePage" ? { mainEntity: { "@id": new URL("/#person", siteUrl).toString() } } : {}),
      ...(type === "article" ? { mainEntity: { "@id": `${pageUrl}#article` } } : {}),
    },
  ],
};
const extraStructuredData = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];
const jsonLd = {
  ...defaultStructuredData,
  "@graph": [...defaultStructuredData["@graph"], ...extraStructuredData],
};
const searchItems = await getSearchItems();
const showBlog = searchItems.some(item => item.kind === "post");
const commandItems = searchItems.map(item => ({
  title: item.title, href: item.href, kind: searchLabels[item.kind],
  // Topic titles already contain their search term. Keep long descriptions in full search.
  keywords: item.kind === "topic" ? undefined :
    [item.summary, item.fullTitle, item.event, ...(item.tags ?? []),
      item.id === "page-resume" ? [...new Set((item.content ?? "").toLowerCase().match(/[a-z0-9+#-]{3,}/g) ?? [])].join(" ") : undefined].filter(Boolean).join(" "),
}));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <meta name="author" content="Enguerrand Allamel" />
    <meta
      name="robots"
      content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
    />
    <title>{pageTitle}</title>
    <link rel="canonical" href={pageUrl} />

    <meta property="og:type" content={type} />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:site_name" content="Enguerrand Allamel" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={imageAlt} />

    {ogImageWidth && <meta property="og:image:width" content={ogImageWidth} />}
    {ogImageHeight && <meta property="og:image:height" content={ogImageHeight} />}
    {type === "article" && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {type === "article" && <meta property="article:author" content={siteUrl.toString()} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <meta name="theme-color" content="#f6f4ef" />

    <script type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- Reapply enhancement styles after ClientRouter replaces the html attributes. -->
    <script is:inline data-astro-rerun>document.documentElement.classList.add("js");</script>
    <ClientRouter fallback="swap" />
  </head>
  <body transition:animate="none" data-motion={pageMotion} class:list={["min-h-screen bg-background font-sans text-foreground antialiased", { "home-page": home }]}>
    <div class="site-page relative isolate min-h-screen">
      <a class="site-skip-link" href="#main-content">Skip to content</a>
      <header transition:persist="site-header" class="site-header site-shell">
        <nav class="site-nav" aria-label="Main navigation" data-site-nav>
          <a class="site-brand" href="/" aria-current={Astro.url.pathname === "/" ? "page" : undefined}>Enguerrand Allamel</a>
          <button
            class="site-nav-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="site-nav-links"
            aria-label="Open navigation"
            data-site-nav-toggle
          >
            <span class="site-nav-toggle-line" aria-hidden="true"></span>
            <span class="site-nav-toggle-line" aria-hidden="true"></span>
          </button>
          <div id="site-nav-links" class="site-nav-links" data-site-nav-links>
            <a href="/talks/" aria-current={Astro.url.pathname.startsWith("/talks/") ? "page" : undefined}>Talks</a>
            {showBlog && <a href="/blog/" aria-current={Astro.url.pathname.startsWith("/blog/") ? "page" : undefined}>Blog</a>}
            <a href="/projects/" aria-current={Astro.url.pathname.startsWith("/projects/") ? "page" : undefined}>Projects</a>
            <a href="/radar/" aria-current={Astro.url.pathname.startsWith("/radar/") || Astro.url.pathname.startsWith("/github-stars/") ? "page" : undefined}>Radar</a>
            <a href="/about/" aria-current={Astro.url.pathname.startsWith("/about/") || Astro.url.pathname.startsWith("/resume/") ? "page" : undefined}>About</a>
          </div>
        </nav>
      </header>

      <main class="site-main site-shell">
        <span id="main-content" tabindex="-1" class="skip-target" aria-label="Main content"></span>
        <slot />
      </main>

      <HarbourFooter showBlog={showBlog} />
    </div>
    <CommandPalette items={commandItems} />
    <script is:inline type="module" data-site-shell src={siteShellUrl}></script>
  </body>
</html>
