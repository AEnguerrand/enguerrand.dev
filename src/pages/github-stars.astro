---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { GitHubStars } from "@/components/sections/GitHubStars";
import { starsDataset, starsGroups, starsDate } from "@/lib/stars";
---
<BaseLayout title="Radar topics" description="Selected technical resources organized by topic.">
  <header class="site-page-header">
    <p class="site-eyebrow">Technical radar</p>
    <h1 class="site-page-title">All topics</h1>
    <p class="mt-4 text-sm text-muted-foreground">{starsGroups.length} topics · {starsDataset.total_repos} repositories · Updated {starsDate(starsDataset.generated_at)}</p>
  </header>
  <GitHubStars dataset={starsDataset} />
</BaseLayout>
