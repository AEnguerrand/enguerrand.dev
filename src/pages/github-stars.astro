---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { GitHubStars } from "@/components/sections/GitHubStars";
import { starsDataset, starsGroups, starsDate } from "@/lib/stars";
---
<BaseLayout title="GitHub Stars" description="A curated collection of my starred GitHub repositories, organized by topic.">
  <header class="pt-6 pb-6 sm:pt-8">
    <h1 class="text-3xl sm:text-4xl">GitHub Stars</h1>
    <p class="mt-3 text-muted-foreground">Repositories I find useful, organized by topic.</p>
    <p class="mt-2 text-xs text-muted-foreground">{starsDataset.total_repos} Stars · {starsGroups.length} Lists · Last updated {starsDate(starsDataset.generated_at)}</p>
  </header>
  <GitHubStars dataset={starsDataset} />
</BaseLayout>
