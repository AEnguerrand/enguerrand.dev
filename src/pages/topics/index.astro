---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageIntro from "@/components/PageIntro.astro";
import { topicDescription, topicHref, topicTitle } from "@/lib/topics";
import { getCollection } from "astro:content";

const talks = await getCollection("talks");
const topicCounts = new Map<string, number>();

for (const talk of talks) {
  for (const topic of talk.data.tags ?? []) {
    topicCounts.set(topic, (topicCounts.get(topic) ?? 0) + 1);
  }
}

const topics = Array.from(topicCounts, ([name, count]) => ({ name, count }))
  .sort((a, b) => b.count - a.count || topicTitle(a.name).localeCompare(topicTitle(b.name), "en"));

const structuredData = {
  "@type": "CollectionPage",
  "@id": "https://enguerrand.dev/topics/#collection",
  url: "https://enguerrand.dev/topics/",
  name: "Cloud Security and Platform Engineering Topics",
  description:
    "Browse Enguerrand Allamel's talks and resources by cloud security, software supply chain, Kubernetes, AWS, npm, and related topics.",
  isPartOf: { "@id": "https://enguerrand.dev/#website" },
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: topics.length,
    itemListElement: topics.map((topic, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: topicTitle(topic.name),
      url: new URL(topicHref(topic.name), Astro.site).toString(),
    })),
  },
};
---

<BaseLayout
  title="Cloud Security & Platform Engineering Topics"
  description="Browse conference talks and practical resources by cloud security, software supply chain security, Kubernetes, AWS, npm, SLSA, and related topics."
  structuredData={structuredData}
>
  <PageIntro title="Talk topics" description={`Browse ${topics.length} topics from conference talks and workshops.`} />
  <section aria-labelledby="topic-list-heading">
    <h2 id="topic-list-heading" class="sr-only">Browse topics</h2>
    <div class="topic-list">
      {topics.map((topic) => (
        <article class="site-list-row topic-row">
          <div class="topic-heading">
            <h3><a href={topicHref(topic.name)}>{topicTitle(topic.name)}</a></h3>
            <span class="topic-count">{topic.count} {topic.count === 1 ? "talk" : "talks"}</span>
          </div>
          <p>{topicDescription(topic.name)}</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .topic-list {display:grid;column-gap:40px;grid-template-columns:repeat(2,minmax(0,1fr));}
  .topic-row {min-width:0;padding:24px 0;}
  .topic-heading {display:flex;flex-wrap:wrap;align-items:baseline;gap:8px 16px;}
  .topic-heading h3 {color:hsl(var(--primary));font-size:20px;font-weight:500;line-height:1.4;}
  .topic-heading a:hover {text-decoration:underline;text-underline-offset:4px;}
  .topic-count {color:hsl(var(--muted-foreground));font-size:12px;font-variant-numeric:tabular-nums;white-space:nowrap;}
  .topic-row p {max-width:65ch;margin-top:10px;color:hsl(var(--muted-foreground));font-size:16px;line-height:1.6;}
  @media(max-width:767px){.topic-list {grid-template-columns:1fr;}.topic-row {padding:20px 0;}}
</style>
