---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { topicDescription, topicHref, topicTitle } from "@/lib/topics";
import { getCollection } from "astro:content";

const talks = await getCollection("talks");
const topicCounts = new Map<string, number>();

for (const talk of talks) {
  for (const topic of talk.data.tags ?? []) {
    topicCounts.set(topic, (topicCounts.get(topic) ?? 0) + 1);
  }
}

const topics = ["cloud security", "software supply chain security", "npm"]
  .map(name => ({name, count: topicCounts.get(name) ?? 0}))
  .filter(topic => topic.count > 0);

const structuredData = {
  "@type": "CollectionPage",
  "@id": "https://enguerrand.dev/topics/#collection",
  url: "https://enguerrand.dev/topics/",
  name: "Cloud Security and Platform Engineering Topics",
  description:
    "Browse Enguerrand Allamel's talks and resources by cloud security, software supply chain, Kubernetes, AWS, npm, and related topics.",
  isPartOf: { "@id": "https://enguerrand.dev/#website" },
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: topics.length,
    itemListElement: topics.map((topic, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: topicTitle(topic.name),
      url: new URL(topicHref(topic.name), Astro.site).toString(),
    })),
  },
};
---

<BaseLayout
  title="Cloud Security & Platform Engineering Topics"
  description="Browse conference talks and practical resources by cloud security, software supply chain security, Kubernetes, AWS, npm, SLSA, and related topics."
  structuredData={structuredData}
>
  <header class="site-page-header">
    <h1 class="site-page-title">Topics</h1>
    <p class="site-lead">Cloud security, software supply chains, and dependency security. Choose a topic to find related talks.</p>
  </header>
  <section class="site-section-divider" aria-labelledby="topic-list-heading">
    <h2 id="topic-list-heading" class="sr-only">Browse topics</h2>
    <div class="site-list mt-0">
      {topics.map((topic) => (
        <article class="site-list-row grid gap-4 py-6 md:grid-cols-[minmax(0,1fr)_auto] md:items-center md:gap-10">
          <div>
            <div class="flex flex-wrap items-baseline gap-x-4 gap-y-2">
              <h3 class="text-2xl font-semibold tracking-tight"><a class="hover:text-primary" href={topicHref(topic.name)}>{topicTitle(topic.name)}</a></h3>
              <span class="whitespace-nowrap text-xs font-semibold tabular-nums text-muted-foreground">{topic.count} {topic.count === 1 ? "talk" : "talks"}</span>
            </div>
            <p class="mt-3 max-w-3xl text-sm leading-relaxed text-muted-foreground">{topicDescription(topic.name)}</p>
          </div>
          <div>
            <a class="site-text-link text-sm font-semibold" href={topicHref(topic.name)}>
              Explore {topicTitle(topic.name)} →
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
