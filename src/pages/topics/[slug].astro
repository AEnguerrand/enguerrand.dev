---
import { canonicalUrl } from "@/lib/seo";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageIntro from "@/components/PageIntro.astro";
import { canonicalTopic, canonicalTopics, countTopics, topicDescription, topicHref, topicKind, topicRoutes, topicSlug, topicTitle } from "@/lib/topics";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const talks = await getCollection("talks");
  return topicRoutes(talks.flatMap((talk) => talk.data.tags ?? []))
    .map(({ slug, topic }) => ({ params: { slug }, props: { topic } }));
}

const { topic } = Astro.props as { topic: string };
const canonical = canonicalTopic(topic);
const isAlias = canonical !== topic;
const allTalks = await getCollection("talks");
const talks = allTalks
  .filter((talk) => canonicalTopics(talk.data.tags ?? []).includes(canonical))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const relatedTopics = countTopics(talks)
  .filter((related) => related.name !== canonical && topicKind(related.name) === "subject")
  .slice(0, 4);

const name = topicTitle(topic);
const description = topicDescription(topic);
const topicUrl = canonicalUrl(`/topics/${topicSlug(topic)}/`, Astro.site ?? new URL("https://enguerrand.dev"));
const structuredData = [
  {
    "@type": "CollectionPage",
    "@id": `${topicUrl}#collection`,
    url: topicUrl,
    name: `${name} talks and resources`,
    description,
    isPartOf: { "@id": "https://enguerrand.dev/#website" },
    about: { "@type": "Thing", name },
    mainEntity: {
      "@type": "ItemList",
      numberOfItems: talks.length,
      itemListElement: talks.map((talk, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: talk.data.title,
        url: new URL(`/talks/${talk.id}/`, Astro.site).toString(),
      })),
    },
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://enguerrand.dev/" },
      { "@type": "ListItem", position: 2, name: "Talk topics", item: "https://enguerrand.dev/topics/" },
      { "@type": "ListItem", position: 3, name, item: topicUrl },
    ],
  },
];
---

<BaseLayout title={`${name} Talks`} description={description} structuredData={structuredData}>
  <nav aria-label="Breadcrumb" class="pt-3 text-sm text-muted-foreground sm:pt-6">
    <ol class="flex flex-wrap items-center gap-2">
      <li><a class="hover:text-foreground" href="/">Home</a></li>
      <li aria-hidden="true">/</li>
      <li><a class="hover:text-foreground" href="/topics/">Talk topics</a></li>
      <li aria-hidden="true">/</li>
      <li aria-current="page" class="text-foreground">{name}</li>
    </ol>
  </nav>

  <PageIntro title={name} description={description} />
  {isAlias && <p class="topic-alias">This subject is also listed under <a href={topicHref(canonical)} class="site-text-link">{topicTitle(canonical)}</a>. Both pages include the same talks.</p>}

  <section aria-labelledby="talks-heading">
    <h2 id="talks-heading" class="site-section-title">Talks</h2>
    <div class="topic-talks">
      {talks.map((talk) => (
        <article class="site-list-row topic-talk">
          <div>
            <p class="text-xs tabular-nums text-muted-foreground">
              {new Date(talk.data.date).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" })}
              {talk.data.event && ` · ${talk.data.event}`}
            </p>
            <h3 class="topic-talk-title">
              <a href={`/talks/${talk.id}/`}>{talk.data.displayTitle ?? talk.data.title}</a>
            </h3>
            {talk.data.summary && <p class="mt-3 max-w-3xl text-base leading-relaxed text-muted-foreground">{talk.data.summary}</p>}
          </div>
          <div class="topic-talk-tags">
            {canonicalTopics(talk.data.tags ?? []).filter((tag) => tag !== canonical && topicKind(tag) === "subject").slice(0, 5).map((tag) => (
              <a href={topicHref(tag)}>
                {topicTitle(tag)}
              </a>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>

  {relatedTopics.length > 0 && (
    <section aria-labelledby="related-heading" class="mt-10">
      <h2 id="related-heading" class="site-section-title">Related subjects</h2>
      <ul class="related-topics">
        {relatedTopics.map((related) => (
          <li class="site-list-row">
            <a class="related-topic" href={topicHref(related.name)}>
              <span>{topicTitle(related.name)}</span>
              <span class="text-xs tabular-nums text-muted-foreground">{related.count}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>

<style>
  .topic-alias {margin-bottom:28px;color:hsl(var(--muted-foreground));font-size:14px;line-height:1.6;}
  .topic-talks {margin-top:8px;}
  .topic-talk {padding:24px 0;}
  .topic-talk-title {margin-top:8px;color:hsl(var(--primary));font-size:20px;font-weight:500;line-height:1.4;}
  .topic-talk-title a:hover {text-decoration:underline;text-underline-offset:4px;}
  .topic-talk-tags {display:flex;flex-wrap:wrap;gap:6px 16px;margin-top:16px;}
  .topic-talk-tags a {min-height:28px;color:hsl(var(--muted-foreground));font-size:12px;text-decoration:underline;text-decoration-color:hsl(var(--border));text-underline-offset:4px;}
  .topic-talk-tags a:hover {color:hsl(var(--primary));text-decoration-color:currentColor;}
  .related-topics {display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:40px;margin-top:16px;}
  .related-topic {display:flex;min-height:64px;align-items:center;justify-content:space-between;gap:16px;padding:12px 0;color:hsl(var(--primary));font-size:16px;}
  @media(max-width:600px){.topic-talk {padding:20px 0;}.related-topics {grid-template-columns:1fr;}}
</style>
