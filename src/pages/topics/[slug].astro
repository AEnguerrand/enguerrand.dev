---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { topicDescription, topicHref, topicSlug, topicTitle } from "@/lib/topics";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const talks = await getCollection("talks");
  const topicNames = Array.from(new Set(talks.flatMap((talk) => talk.data.tags ?? [])));

  return topicNames.map((topic) => ({ params: { slug: topicSlug(topic) }, props: { topic } }));
}

const { topic } = Astro.props as { topic: string };
const allTalks = await getCollection("talks");
const talks = allTalks
  .filter((talk) => (talk.data.tags ?? []).includes(topic))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const relatedTopicCounts = new Map<string, number>();
for (const talk of talks) {
  for (const tag of talk.data.tags ?? []) {
    if (tag !== topic) relatedTopicCounts.set(tag, (relatedTopicCounts.get(tag) ?? 0) + 1);
  }
}
const relatedTopics = Array.from(relatedTopicCounts, ([name, count]) => ({ name, count }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name))
  .slice(0, 4);

const name = topicTitle(topic);
const description = topicDescription(topic);
const topicUrl = new URL(topicHref(topic), Astro.site).toString();
const structuredData = [
  {
    "@type": "CollectionPage",
    "@id": `${topicUrl}#collection`,
    url: topicUrl,
    name: `${name} talks and resources`,
    description,
    isPartOf: { "@id": "https://enguerrand.dev/#website" },
    about: { "@type": "Thing", name },
    mainEntity: {
      "@type": "ItemList",
      numberOfItems: talks.length,
      itemListElement: talks.map((talk, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: talk.data.title,
        url: new URL(`/talks/${talk.id}/`, Astro.site).toString(),
      })),
    },
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://enguerrand.dev/" },
      { "@type": "ListItem", position: 2, name: "Topics", item: "https://enguerrand.dev/topics/" },
      { "@type": "ListItem", position: 3, name, item: topicUrl },
    ],
  },
];
---

<BaseLayout title={`${name} Talks`} description={description} structuredData={structuredData}>
  <nav aria-label="Breadcrumb" class="pt-3 text-sm text-muted-foreground sm:pt-6">
    <ol class="flex flex-wrap items-center gap-2">
      <li><a class="hover:text-foreground" href="/">Home</a></li>
      <li aria-hidden="true">/</li>
      <li><a class="hover:text-foreground" href="/topics/">Topics</a></li>
      <li aria-hidden="true">/</li>
      <li aria-current="page" class="text-foreground">{name}</li>
    </ol>
  </nav>

  <header class="site-page-header">
    <h1 class="site-page-title">{name}</h1>
    <p class="site-lead">{description}</p>
  </header>

  <section class="site-section-divider" aria-labelledby="talks-heading">
    <h2 id="talks-heading" class="text-3xl font-semibold tracking-tight">Talks about {name}</h2>
    <div class="site-list">
      {talks.map((talk) => (
        <article class="site-list-row grid gap-4 py-6 lg:grid-cols-[minmax(0,1fr)_14rem] lg:gap-10">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.08em] text-muted-foreground">
              {new Date(talk.data.date).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" })}
              {talk.data.event && ` · ${talk.data.event}`}
            </p>
            <h3 class="text-2xl font-semibold leading-snug tracking-tight">
              <a class="hover:text-primary" href={`/talks/${talk.id}/`}>{talk.data.displayTitle ?? talk.data.title}</a>
            </h3>
            {talk.data.summary && <p class="mt-3 max-w-3xl text-sm leading-relaxed text-muted-foreground">{talk.data.summary}</p>}
          </div>
          <div class="space-y-4 lg:pt-1">
            <div class="flex flex-wrap gap-x-4 gap-y-2">
              {(talk.data.tags ?? []).filter((tag) => tag !== topic).slice(0, 5).map((tag) => (
                <a class="text-[11px] font-semibold uppercase tracking-[0.06em] text-primary hover:underline" href={topicHref(tag)}>
                  {topicTitle(tag)}
                </a>
              ))}
            </div>
            <a class="site-text-link text-sm font-semibold" href={`/talks/${talk.id}/`}>
              Read talk details →
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  {relatedTopics.length > 0 && (
    <section aria-labelledby="related-heading" class="site-section-divider mt-10">
      <h2 id="related-heading" class="text-2xl font-semibold tracking-tight">Related topics</h2>
      <ul class="site-list">
        {relatedTopics.map((related) => (
          <li class="site-list-row">
            <a class="flex min-h-14 items-center justify-between gap-4 py-2 text-sm font-semibold hover:text-primary" href={topicHref(related.name)}>
              <span>{topicTitle(related.name)}</span>
              <span class="text-xs uppercase tracking-[0.08em] text-muted-foreground">{related.count}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>
