---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { ArrowRight, FileText, GithubLogo, LinkedinLogo } from "@phosphor-icons/react";
---

<BaseLayout
  title="About"
  pageType="ProfilePage"
  description="About Enguerrand Allamel, a Senior Platform Security Engineer in Vancouver who builds secure cloud platforms and practical software."
>
  <section class="site-page-header about-intro" data-reveal>
    <p class="site-eyebrow">About me</p>
    <h1 class="site-page-title max-w-3xl">
      I build secure platforms and practical tools.
    </h1>
    <div class="mt-7 grid gap-8 text-lg leading-relaxed text-muted-foreground md:grid-cols-[1fr_13rem] md:items-start">
      <div class="space-y-5">
        <p>
          I’m Enguerrand Allamel, a Senior Platform Security Engineer based in Vancouver, BC. My work connects cloud security, reliability, and developer platforms.
        </p>
        <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
          <a class="site-action site-action-primary group" href="/resume/">
            <FileText className="h-4 w-4" aria-hidden="true" /> Read my resume
            <ArrowRight className="motion-arrow h-4 w-4" aria-hidden="true" />
          </a>
          <a class="site-link" href="https://github.com/AEnguerrand"><GithubLogo className="h-4 w-4" aria-hidden="true" /> GitHub</a>
          <a class="site-link" href="https://www.linkedin.com/in/enguerrandallamel/"><LinkedinLogo className="h-4 w-4" aria-hidden="true" /> LinkedIn</a>
        </div>
        <p>
          I focus on controls that help teams ship safely: AI development guardrails, AWS and Kubernetes security, software supply chain security, and useful automation.
        </p>
        <p>
          Outside my day-to-day work, I speak about lessons from real systems and build Foliobruma, a private archive for paper records and family history.
        </p>
      </div>
      <img
        src="/avatar.webp"
        alt="Enguerrand Allamel speaking at a conference"
        class="aspect-square w-40 rounded-full border border-border object-cover shadow-[0_12px_30px_hsl(var(--foreground)/0.08)] md:w-full"
        width="224"
        height="224"
        loading="eager"
        decoding="async"
      />
    </div>

  </section>

  <section class="site-section-divider about-focus" aria-labelledby="about-focus-title" data-reveal>
    <div class="about-focus-heading">
      <h2 id="about-focus-title" class="site-section-title">Areas of focus</h2>
    </div>
    <div class="about-focus-list">
      <a class="about-focus-item" href="/radar/">
        <div><h3>Platform security</h3><p>Cloud, Kubernetes, identity, delivery systems, and secure defaults.</p></div>
        <ArrowRight className="motion-arrow" size={20} aria-hidden="true" />
      </a>
      <a class="about-focus-item" href="/talks/">
        <div><h3>Public work</h3><p>Talks, field notes, and practical examples from production systems.</p></div>
        <ArrowRight className="motion-arrow" size={20} aria-hidden="true" />
      </a>
      <a class="about-focus-item" href="/projects/">
        <div><h3>Independent tools</h3><p>Private, local-first software for documents, archives, and research.</p></div>
        <ArrowRight className="motion-arrow" size={20} aria-hidden="true" />
      </a>
    </div>
  </section>
</BaseLayout>
