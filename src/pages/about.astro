---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { ArrowRight, FileText, Github, Linkedin } from "lucide-react";
---

<BaseLayout
  title="About"
  pageType="ProfilePage"
  description="About Enguerrand Allamel, a Senior Platform Security Engineer in Vancouver who builds secure cloud platforms and practical software."
>
  <section class="mx-auto max-w-4xl pb-12 pt-6 sm:pt-10">
    <p class="text-sm font-semibold uppercase tracking-[0.14em] text-primary">About me</p>
    <h1 class="mt-4 max-w-3xl text-4xl font-semibold leading-tight sm:text-5xl">
      I build secure platforms and practical tools.
    </h1>
    <div class="mt-7 grid gap-8 text-lg leading-relaxed text-muted-foreground md:grid-cols-[1fr_13rem] md:items-start">
      <div class="space-y-5">
        <p>
          I’m Enguerrand Allamel, a Senior Platform Security Engineer based in Vancouver, BC. My work connects cloud security, reliability, and developer platforms.
        </p>
        <p>
          I focus on controls that help teams ship safely: AI development guardrails, AWS and Kubernetes security, software supply chain security, and useful automation.
        </p>
        <p>
          Outside my day-to-day work, I speak about lessons from real systems and build Foliobruma, a private archive for paper records and family history.
        </p>
      </div>
      <img
        src="/avatar.webp"
        alt="Enguerrand Allamel speaking at a conference"
        class="aspect-square w-40 rounded-full border border-border object-cover shadow-[0_12px_30px_hsl(var(--foreground)/0.08)] md:w-full"
        width="224"
        height="224"
        loading="eager"
        decoding="async"
      />
    </div>

    <div class="mt-9 flex flex-wrap gap-3">
      <a class="group inline-flex min-h-11 items-center gap-2 rounded-full border border-primary bg-primary px-5 font-semibold text-primary-foreground transition-all hover:-translate-y-0.5 hover:border-accent hover:bg-accent hover:text-accent-foreground hover:shadow-[0_10px_24px_hsl(var(--accent)/0.18)]" href="/resume/">
        <FileText className="h-4 w-4" aria-hidden="true" />
        Read my resume
        <ArrowRight className="h-4 w-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
      </a>
      <a class="inline-flex min-h-11 items-center gap-2 rounded-full border border-primary px-5 font-semibold text-primary transition-all hover:-translate-y-0.5 hover:bg-primary hover:text-primary-foreground hover:shadow-[0_10px_24px_hsl(var(--primary)/0.16)]" href="https://github.com/AEnguerrand">
        <Github className="h-4 w-4" aria-hidden="true" /> GitHub
      </a>
      <a class="inline-flex min-h-11 items-center gap-2 rounded-full border border-primary px-5 font-semibold text-primary transition-all hover:-translate-y-0.5 hover:bg-primary hover:text-primary-foreground hover:shadow-[0_10px_24px_hsl(var(--primary)/0.16)]" href="https://www.linkedin.com/in/enguerrandallamel/">
        <Linkedin className="h-4 w-4" aria-hidden="true" /> LinkedIn
      </a>
    </div>
  </section>

  <section class="mx-auto grid max-w-4xl gap-px overflow-hidden rounded-2xl border border-border bg-border sm:grid-cols-3" aria-label="Areas of focus">
    <article class="bg-card/90 p-6">
      <h2 class="text-2xl font-semibold">Platform security</h2>
      <p class="mt-3 leading-relaxed text-muted-foreground">Cloud, Kubernetes, identity, delivery systems, and secure defaults.</p>
    </article>
    <article class="bg-card/90 p-6">
      <h2 class="text-2xl font-semibold">Public work</h2>
      <p class="mt-3 leading-relaxed text-muted-foreground">Talks, field notes, and practical examples from production systems.</p>
    </article>
    <article class="bg-card/90 p-6">
      <h2 class="text-2xl font-semibold">Independent tools</h2>
      <p class="mt-3 leading-relaxed text-muted-foreground">Private, local-first software for documents, archives, and research.</p>
    </article>
  </section>
</BaseLayout>
