---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageIntro from "@/components/PageIntro.astro";
---

<BaseLayout title="Page not found" description="The page you are looking for does not exist." noindex={true}>
  <PageIntro
    title="A little off course."
    eyebrow="Error 404"
    description="The link may be outdated or the page may have moved."
    art="/images/illustrations/off-course.webp"
    artSize="large"
  >
    <div class="site-action-row">
      <a class="site-action site-action-primary" href="/">Go back home</a>
      <a class="site-text-link" href="/search/">Search the site</a>
    </div>
  </PageIntro>
</BaseLayout>
