---
import { render, type CollectionEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { canonicalUrl } from "@/lib/seo";
import { formatPostDate, getPosts, isPublishedPost } from "@/lib/posts";

export async function getStaticPaths() {
  return (await getPosts({ includeUnpublished: import.meta.env.DEV })).map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props { post: CollectionEntry<"posts"> }
const { post } = Astro.props;
const { Content } = await render(post);
const publishDate = post.data.publishDate;
const published = isPublishedPost(post.data);
const siteUrl = Astro.site ?? new URL("https://enguerrand.dev");
const articleUrl = canonicalUrl(Astro.url.pathname, siteUrl);
const structuredData = published ? {
  "@type": "BlogPosting",
  "@id": `${articleUrl}#article`,
  headline: post.data.title,
  description: post.data.description,
  datePublished: `${publishDate}T00:00:00.000Z`,
  author: { "@type": "Person", "@id": new URL("/#person", siteUrl).toString(), name: "Enguerrand Allamel", url: siteUrl.toString() },
  mainEntityOfPage: articleUrl,
  url: articleUrl,
  image: new URL("/og-image.jpg", siteUrl).toString(),
  isPartOf: { "@id": new URL("/#website", siteUrl).toString() },
  keywords: post.data.tags,
} : undefined;
---

<BaseLayout noindex={!published} title={post.data.title} description={post.data.description} type="article" publishedTime={published ? `${publishDate}T00:00:00.000Z` : undefined} structuredData={structuredData}>
  <article class="mx-auto max-w-3xl pt-6 sm:pt-9">
    <a href="/blog/" class="inline-block rounded-sm text-sm font-semibold text-primary hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring">← Back to blog</a>
    <header class="mt-5 border-b border-border/70 pb-6">
      {!published && <p class="mb-3 text-sm font-semibold text-primary">Local preview · {post.data.draft ? "Draft" : "Scheduled"}</p>}
      {publishDate && <time datetime={publishDate} class="text-sm text-muted-foreground">{formatPostDate(publishDate)}</time>}
      <h1 class="mt-4 break-words text-3xl font-semibold leading-tight sm:text-4xl">{post.data.title}</h1>
      <p class="mt-4 text-base leading-relaxed text-muted-foreground">{post.data.description}</p>
      <p class="mt-3 text-sm text-muted-foreground">By Enguerrand Allamel</p>
      {post.data.tags.length > 0 && (
        <ul aria-label="Tags" class="mt-5 flex flex-wrap gap-2 text-xs text-muted-foreground">
          {post.data.tags.map((tag) => <li class="rounded-full border border-border/80 bg-secondary/55 px-3 py-1">{tag}</li>)}
        </ul>
      )}
    </header>
    <div class="prose prose-headings:scroll-mt-28 prose-p:leading-relaxed mt-6 max-w-none break-words rounded-2xl border border-border/70 bg-card/90 p-6 [overflow-wrap:anywhere] prose-pre:max-w-full prose-pre:overflow-x-auto sm:p-9">
      <Content />
    </div>
  </article>
</BaseLayout>
