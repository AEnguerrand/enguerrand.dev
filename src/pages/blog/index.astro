---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { formatPostDate, getPosts, isPublishedPost, postHref } from "@/lib/posts";

const posts = await getPosts({ includeUnpublished: import.meta.env.DEV });
---

<BaseLayout noindex={import.meta.env.DEV} title="Blog" description="Notes on life in Canada, security, and AI by Enguerrand Allamel.">
  <section class="pt-3 pb-8 sm:pt-6" aria-labelledby="blog-title">
    <h1 id="blog-title" class="text-3xl font-semibold leading-tight tracking-tight sm:text-4xl">Blog</h1>
    <p class="mt-3 max-w-3xl text-base leading-relaxed text-muted-foreground">Notes on life in Canada, security, and AI.</p>
  </section>

  <section aria-labelledby="posts-title">
    <h2 id="posts-title" class="mb-4 text-2xl font-semibold tracking-tight">Latest posts</h2>
    {posts.length > 0 ? (
      <div class="grid gap-5 md:grid-cols-2">
        {posts.map((post) => (
          <article class="lift-card flex flex-col rounded-2xl border border-border/70 bg-card/90 p-6 shadow-[0_12px_32px_hsl(var(--foreground)/0.05)] sm:p-7">
            {!isPublishedPost(post.data) && <p class="mb-2 text-sm font-semibold text-primary">Local preview · {post.data.draft ? "Draft" : "Scheduled"}</p>}
            {post.data.publishDate && <time datetime={post.data.publishDate} class="text-sm text-muted-foreground">{formatPostDate(post.data.publishDate)}</time>}
            <h3 class="mt-3 break-words text-2xl font-semibold leading-snug">
              <a class="rounded-sm hover:text-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring" href={postHref(post.id)}>{post.data.title}</a>
            </h3>
            <p class="mt-3 leading-relaxed text-muted-foreground">{post.data.description}</p>
            {post.data.tags.length > 0 && (
              <ul aria-label="Tags" class="mt-5 flex flex-wrap gap-2 text-xs text-muted-foreground">
                {post.data.tags.map((tag) => <li class="rounded-full border border-border/80 bg-secondary/55 px-3 py-1">{tag}</li>)}
              </ul>
            )}
          </article>
        ))}
      </div>
    ) : (
      <div class="rounded-2xl border border-border/70 bg-card/90 p-7">
        <p class="text-xl font-semibold">No posts published yet.</p>
        <p class="mt-3 max-w-2xl leading-relaxed text-muted-foreground">This space is ready for notes on Canada, security, and AI. Check back for the first post.</p>
      </div>
    )}
  </section>
</BaseLayout>
