---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageIntro from "@/components/PageIntro.astro";
import { ArrowRight, Notebook } from "@phosphor-icons/react";
import { formatPostDate, getPosts, isPublishedPost, postHref } from "@/lib/posts";

const posts = await getPosts({ includeUnpublished: import.meta.env.DEV });
---

<BaseLayout noindex={import.meta.env.DEV} title="Blog" description="Notes on platform security, software delivery, and practical tools by Enguerrand Allamel.">
  <PageIntro title="Blog" />

  <section class="site-section-divider blog-index" aria-label="Blog posts" data-reveal>
    {posts.length > 0 ? (
      <>
        <h2 class="site-section-title blog-section-title">Latest posts</h2>
        <ul class="site-list blog-posts">
          {posts.map((post) => (
            <li class="site-list-row">
              <article class="blog-entry">
                <div class="blog-entry-meta">
                  {!isPublishedPost(post.data) && <p class="blog-preview-label">Local preview · {post.data.draft ? "Draft" : "Scheduled"}</p>}
                  {post.data.publishDate && <time datetime={post.data.publishDate}>{formatPostDate(post.data.publishDate)}</time>}
                </div>
                <div class="blog-entry-copy">
                  <h3 class="blog-post-title"><a href={postHref(post.id)}>{post.data.title}</a></h3>
                  <p class="blog-post-description">{post.data.description}</p>
                  {post.data.tags.length > 0 && (
                    <ul aria-label="Tags" class="blog-tags">
                      {post.data.tags.map((tag) => <li>{tag}</li>)}
                    </ul>
                  )}
                </div>
              </article>
            </li>
          ))}
        </ul>
      </>
    ) : (
      <div class="blog-empty-state">
        <div class="blog-empty-mark" aria-hidden="true"><Notebook size={56} weight="duotone" /></div>
        <div>
          <h2>No posts yet</h2>
          <div class="blog-empty-actions">
            <a class="site-link" href="/talks/">Browse talks <ArrowRight size={18} className="motion-arrow" aria-hidden="true" /></a>
            <a class="site-link" href="/radar/">Explore the radar <ArrowRight size={18} className="motion-arrow" aria-hidden="true" /></a>
          </div>
        </div>
      </div>
    )}
  </section>
</BaseLayout>

<style>
  .blog-index {max-width:52rem;}
  .blog-section-title {font-size:1.5rem;line-height:1.3;}
  .blog-posts {margin-top:20px;}
  .blog-entry {display:grid;grid-template-columns:9rem minmax(0,1fr);gap:24px;padding:24px 0;}
  .blog-entry-meta {padding-top:3px;color:hsl(var(--muted-foreground));font-size:.8125rem;line-height:1.6;font-variant-numeric:tabular-nums;}
  .blog-preview-label {margin-bottom:6px;color:hsl(var(--primary));font-weight:500;}
  .blog-entry-copy {min-width:0;}
  .blog-post-title {font-size:1.25rem;font-weight:500;line-height:1.4;overflow-wrap:anywhere;}
  .blog-post-title a {border-radius:2px;transition:color 160ms ease;}
  .blog-post-title a:hover {color:hsl(var(--primary));}
  .blog-post-title a:focus-visible {outline:2px solid hsl(var(--ring));outline-offset:5px;}
  .blog-post-description {max-width:62ch;margin-top:8px;color:hsl(var(--muted-foreground));font-size:.9375rem;line-height:1.7;}
  .blog-tags {display:flex;flex-wrap:wrap;gap:4px 16px;margin-top:12px;color:hsl(var(--muted-foreground));font-size:.75rem;line-height:1.6;}
  .blog-empty-state {display:flex;align-items:flex-start;gap:24px;padding-top:8px;}
  .blog-empty-mark {flex-shrink:0;color:hsl(var(--primary) / .7);}
  .blog-empty-state h2 {font-size:1.5rem;line-height:1.4;}
  .blog-empty-actions {margin-top:14px;}
  .blog-empty-actions a {min-height:44px;font-size:.9375rem;}
  @media(max-width:600px) {
    .blog-entry {grid-template-columns:1fr;gap:8px;}
    .blog-empty-state {gap:16px;}
    .blog-empty-mark :global(svg) {width:44px;height:44px;}
    .blog-empty-actions {gap:0 20px;}
  }
  @media(prefers-reduced-motion:reduce) {.blog-post-title a {transition:none;}}
</style>
