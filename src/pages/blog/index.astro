---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { formatPostDate, getPosts, isPublishedPost, postHref } from "@/lib/posts";

const posts = await getPosts({ includeUnpublished: import.meta.env.DEV });
---

<BaseLayout noindex={import.meta.env.DEV} title="Security, AI & Canada Blog" description="Notes on life in Canada, security, and AI by Enguerrand Allamel.">
  <section class="site-page-header" aria-labelledby="blog-title">
    <h1 id="blog-title" class="site-page-title">Blog</h1>
    <p class="site-lead">Notes on life in Canada, security, and AI.</p>
  </section>

  <section class="site-section-divider" aria-labelledby="posts-title">
    <h2 id="posts-title" class="mb-4 text-2xl font-semibold tracking-tight">{posts.length > 0 ? "Latest posts" : "Writing in progress"}</h2>
    {posts.length > 0 ? (
      <ul class="site-list">
        {posts.map((post) => (
          <li class="site-list-row">
            <article class="py-6 sm:py-7">
              {!isPublishedPost(post.data) && <p class="mb-2 text-sm font-semibold text-primary">Local preview · {post.data.draft ? "Draft" : "Scheduled"}</p>}
              {post.data.publishDate && <time datetime={post.data.publishDate} class="text-sm text-muted-foreground">{formatPostDate(post.data.publishDate)}</time>}
              <h3 class="mt-3 break-words font-sans text-2xl font-semibold leading-snug">
                <a class="rounded-sm hover:text-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring" href={postHref(post.id)}>{post.data.title}</a>
              </h3>
              <p class="mt-3 max-w-3xl leading-relaxed text-muted-foreground">{post.data.description}</p>
              {post.data.tags.length > 0 && (
                <ul aria-label="Tags" class="mt-5 flex flex-wrap gap-2 text-xs text-muted-foreground">
                  {post.data.tags.map((tag) => <li class="rounded-full border border-border/80 bg-secondary/55 px-3 py-1">{tag}</li>)}
                </ul>
              )}
            </article>
          </li>
        ))}
      </ul>
    ) : (
      <div class="site-open-surface">
        <p class="text-xl font-semibold">The first post is in progress.</p>
        <p class="mt-3 max-w-2xl leading-relaxed text-muted-foreground">In the meantime, you can read the notes from my OWASP France talk about the September 2025 npm supply chain attacks.</p>
        <a class="site-link mt-5" href="/talks/meetup-owasp-france-chapter-10-2025/">Read the talk notes →</a>
      </div>
    )}
  </section>
</BaseLayout>
