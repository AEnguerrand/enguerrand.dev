---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { RepoCard } from "@/components/sections/GitHubStars";
import { starsDataset, starsGroups, starsDate, starsListName, starsListHref, starsPageSize, type StarredGroup } from "@/lib/stars";

export function getStaticPaths() {
  return starsGroups.flatMap(group => {
    const pages = Math.ceil(group.repos.length / starsPageSize);
    return Array.from({length: pages}, (_, index) => ({
      params: {list: group.slug, page: index === 0 ? undefined : String(index + 1)},
      props: {group, pageNumber: index + 1, pageCount: pages},
    }));
  });
}
const {group,pageNumber,pageCount} = Astro.props as {group:StarredGroup;pageNumber:number;pageCount:number};
const name = starsListName(group.name);
const repos = group.repos.slice((pageNumber-1)*starsPageSize,pageNumber*starsPageSize);
const suffix = pageNumber > 1 ? ` — Page ${pageNumber}` : "";
---
<BaseLayout title={`${name} GitHub Stars${suffix}`} description={`Browse ${name} repositories from my GitHub Stars. Page ${pageNumber} of ${pageCount}; ${group.repos.length} repositories in this list.`}>
  <header class="site-page-header">
    <a href="/github-stars/" class="site-link text-sm">← All lists</a>
    <h1 class="site-page-title">{name}</h1>
    {group.description && <p class="site-lead">{group.description}</p>}
    <p class="mt-2 text-xs text-muted-foreground">{group.repos.length} repositories · Page {pageNumber} of {pageCount} · Snapshot {starsDate(starsDataset.generated_at)}</p>
  </header>
  <section class="site-section-divider" aria-labelledby="repos-heading">
    <h2 id="repos-heading" class="sr-only">Repositories</h2>
    <div class="site-list grid gap-x-6 sm:grid-cols-2 xl:grid-cols-3">{repos.map(repo => <RepoCard repo={repo}/>)}</div>
  </section>
  {pageCount > 1 && <nav aria-label="Repository pages" class="mt-6 flex flex-wrap items-center justify-between gap-3 text-sm">
    {pageNumber > 1 ? <a rel="prev" href={starsListHref(group.slug,pageNumber-1)} class="site-action site-action-secondary">← Previous</a> : <span/>}
    <span class="text-muted-foreground">Page {pageNumber} of {pageCount}</span>
    {pageNumber < pageCount ? <a rel="next" href={starsListHref(group.slug,pageNumber+1)} class="site-action site-action-secondary">Next →</a> : <span/>}
  </nav>}
</BaseLayout>
