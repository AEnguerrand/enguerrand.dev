---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageIntro from "@/components/PageIntro.astro";
import { RepoCard } from "@/components/sections/GitHubStars";
import RadarRepositoryFilter from "@/components/sections/RadarRepositoryFilter.astro";
import { starsDataset, starsGroups, starsDate, starsListName, starsListDescription, starsListHref, starsPageSize, type StarredGroup } from "@/lib/stars";

export function getStaticPaths() {
  return starsGroups.flatMap(group => {
    const pages = Math.ceil(group.repos.length / starsPageSize);
    return Array.from({length: pages}, (_, index) => ({
      params: {list: group.slug, page: index === 0 ? undefined : String(index + 1)},
      props: {group, pageNumber: index + 1, pageCount: pages},
    }));
  });
}
const {group,pageNumber,pageCount} = Astro.props as {group:StarredGroup;pageNumber:number;pageCount:number};
const name = starsListName(group.name);
const description = starsListDescription(group);
const repositoryCount = `${group.repos.length} ${group.repos.length === 1 ? "repository" : "repositories"}`;
const repos = group.repos.slice((pageNumber-1)*starsPageSize,pageNumber*starsPageSize);
const suffix = pageNumber > 1 ? ` — Page ${pageNumber}` : "";
const languages = [...new Set(group.repos.map((repo) => repo.language).filter((language): language is string => Boolean(language)))].sort((a, b) => a.localeCompare(b));
---
<BaseLayout title={`${name} bookmarks${suffix}`} description={`${description} Page ${pageNumber} of ${pageCount}; ${repositoryCount} saved in this topic.`}>
  <nav class="repository-back" aria-label="Breadcrumb"><a href="/radar/" class="site-back-link">← Radar</a><a href="/github-stars/" class="site-back-link">All repository topics</a></nav>
  <PageIntro title={name} description={description}>
    <p class="text-sm text-muted-foreground">Bookmarks for reference; inclusion does not indicate testing or a recommendation.</p>
    <p class="site-page-meta">{repositoryCount} · Page {pageNumber} of {pageCount} · Updated {starsDate(starsDataset.generated_at)}</p>
  </PageIntro>
  <section aria-labelledby="repos-heading">
    <h2 id="repos-heading" class="sr-only">Repositories</h2>
    <RadarRepositoryFilter languages={languages} pageNumber={pageNumber} slug={group.slug} total={group.repos.length} />
    <div class="repository-list grid gap-x-10 md:grid-cols-2" data-radar-default>{repos.map(repo => <RepoCard repo={repo}/>)}</div>
  </section>
  {pageCount > 1 && <nav aria-label="Repository pages" class="mt-6 flex flex-wrap items-center justify-between gap-3 text-sm" data-radar-pagination>
    {pageNumber > 1 ? <a rel="prev" href={starsListHref(group.slug,pageNumber-1)} class="site-action site-action-secondary">← Previous</a> : <span/>}
    <span class="text-muted-foreground">Page {pageNumber} of {pageCount}</span>
    {pageNumber < pageCount ? <a rel="next" href={starsListHref(group.slug,pageNumber+1)} class="site-action site-action-secondary">Next →</a> : <span/>}
  </nav>}
</BaseLayout>

<style>
  .repository-back {display:flex;flex-wrap:wrap;gap:8px 24px;padding-top:12px;}
  .repository-list {margin-top:8px;}
</style>
