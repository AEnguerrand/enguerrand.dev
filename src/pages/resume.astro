---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageIntro from "@/components/PageIntro.astro";
import { LinkedinLogo } from "@phosphor-icons/react";
import { certifications, community, education, experience, resumeProfile, resumeSections, skills } from "@/data/resume";
---

<BaseLayout
  title="Platform Security Engineer Resume"
  motion="static"
  pageType="ProfilePage"
  description="Resume of Enguerrand Allamel, a Senior Platform Security Engineer specializing in AI development guardrails, AWS, Kubernetes, SLSA, SRE, and secure CI/CD."
>
  <div class="resume-page">
    <PageIntro title={resumeProfile.name} eyebrow={resumeProfile.eyebrow} class="resume-header">
      <p class="resume-title">{resumeProfile.title}</p>
      <p class="resume-intro">{resumeProfile.intro}</p>
      <div class="site-action-row">
        <a class="site-action site-action-primary resume-link" href={resumeProfile.linkHref} target="_blank" rel="noreferrer">
          <LinkedinLogo aria-hidden="true" className="h-4 w-4 shrink-0" />
          <span>{resumeProfile.linkLabel}</span>
        </a>
      </div>
    </PageIntro>

    <section class="site-section-divider resume-experience" aria-labelledby="experience-heading">
      <h2 id="experience-heading" class="resume-section-title">{resumeSections.experience}</h2>
      <div class="resume-companies">
        {experience.map((company) => (
          <article class="resume-company">
            <div class="resume-company-heading">
              <h3>{company.company}</h3>
              {company.roles.length > 1 && <p class="resume-period">{company.period}</p>}
            </div>
            <div class="resume-roles">
              {company.roles.map((role) => (
                <div class="resume-role">
                  <div class="resume-role-heading">
                    <h4>{role.title}</h4>
                    <p class="resume-period">{role.period ?? company.period}</p>
                  </div>
                  <ul class="resume-bullets">
                    {role.bullets.map((bullet) => <li>{bullet}</li>)}
                  </ul>
                </div>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="resume-details">
      <article>
        <h2 class="resume-section-title">{resumeSections.education}</h2>
        <div class="resume-education">
          {education.map((item) => (
            <div class="resume-school">
              <h3>{item.school}</h3>
              <p class="resume-period">{item.period}</p>
              <p>{item.degree}</p>
            </div>
          ))}
        </div>
      </article>
      <article>
        <h2 class="resume-section-title">{resumeSections.community}</h2>
        <div class="resume-community">
          {community.map((item) => (
            <div class="resume-community-item">
              <p>{item.text}</p>
              <ul class="resume-evidence-links">
                {item.links.map((link) => <li><a href={link.href} class="site-text-link">{link.label}{link.href.startsWith("https://") ? " ↗" : " →"}</a></li>)}
              </ul>
            </div>
          ))}
        </div>
      </article>
    </section>

    <section class="site-section-divider resume-skills" aria-labelledby="skills-heading">
      <h2 id="skills-heading" class="resume-section-title">{resumeSections.skills}</h2>
      <div class="resume-certifications">
        <h3 class="site-eyebrow">{resumeSections.certifications}</h3>
        <div class="resume-certification-list">
          {certifications.map((item) => (
            <div class="resume-certification">
              <img src={item.logo} alt={item.alt} width="40" height="40" loading="lazy" decoding="async" />
              <p>{item.name}</p>
            </div>
          ))}
        </div>
      </div>
      <dl class="resume-skills-list">
        {skills.map(([label, value]) => (
          <div><dt>{label}</dt><dd>{value}</dd></div>
        ))}
      </dl>
    </section>
  </div>
</BaseLayout>

<style>
  .resume-page {max-width:58rem;}
  .resume-page :global(.resume-header) {max-width:46rem;}
  .resume-title {margin-top:12px;color:hsl(var(--primary));font-size:1.125rem;font-weight:500;}
  .resume-intro {max-width:65ch;margin-top:16px;color:hsl(var(--muted-foreground));font-size:1rem;line-height:1.75;}
  .resume-link {min-height:44px;font-size:.875rem;}
  .resume-section-title {font-size:1.5rem;line-height:1.3;}
  .resume-companies {margin-top:24px;}
  .resume-company {display:grid;grid-template-columns:10rem minmax(0,1fr);gap:32px;padding:28px 0;}
  .resume-company:first-child {padding-top:0;}
  .resume-company + .resume-company {border-top:1px solid hsl(var(--border));}
  .resume-company-heading h3 {font-size:1.25rem;line-height:1.4;}
  .resume-period {margin-top:5px;color:hsl(var(--muted-foreground));font-size:.8125rem;line-height:1.6;font-variant-numeric:tabular-nums;}
  .resume-role + .resume-role {margin-top:28px;padding-top:24px;border-top:1px solid hsl(var(--border) / .6);}
  .resume-role h4 {font-family:var(--font-sans);font-size:1rem;font-weight:600;line-height:1.5;}
  .resume-bullets {max-width:65ch;margin-top:12px;padding-left:18px;list-style:disc;color:hsl(var(--muted-foreground));font-size:.9375rem;line-height:1.7;}
  .resume-bullets li + li {margin-top:7px;}
  .resume-bullets li::marker {color:hsl(var(--primary) / .55);}
  .resume-details {display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:40px;margin:8px 0 32px;padding-top:28px;border-top:1px solid hsl(var(--border));}
  .resume-education,.resume-community {margin-top:20px;color:hsl(var(--muted-foreground));font-size:.9375rem;line-height:1.7;}
  .resume-school + .resume-school,.resume-community-item + .resume-community-item {margin-top:16px;}
  .resume-evidence-links {display:flex;flex-wrap:wrap;gap:0 16px;margin-top:6px;font-size:.8125rem;}
  .resume-evidence-links a {display:inline-flex;align-items:center;min-height:44px;}
  .resume-school h3 {color:hsl(var(--foreground));font-family:var(--font-sans);font-size:.9375rem;font-weight:500;line-height:1.6;}
  .resume-school > p:last-child {margin-top:5px;}
  .resume-certifications {margin-top:24px;}
  .resume-certifications h3 {font-family:var(--font-sans);}
  .resume-certification-list {display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:16px 24px;margin-top:14px;}
  .resume-certification {display:flex;align-items:center;gap:12px;font-size:.875rem;line-height:1.5;}
  .resume-certification img {width:40px;height:40px;flex-shrink:0;object-fit:contain;}
  .resume-skills-list {margin-top:24px;border-top:1px solid hsl(var(--border));}
  .resume-skills-list > div {display:grid;grid-template-columns:10rem minmax(0,1fr);gap:32px;padding:14px 0;border-bottom:1px solid hsl(var(--border) / .65);font-size:.875rem;line-height:1.7;}
  .resume-skills-list dt {font-weight:500;}
  .resume-skills-list dd {color:hsl(var(--muted-foreground));}
  @media(max-width:700px) {
    .resume-company {grid-template-columns:1fr;gap:16px;padding:24px 0;}
    .resume-company-heading {display:flex;flex-wrap:wrap;align-items:baseline;gap:4px 16px;}
    .resume-company-heading .resume-period {margin-top:0;}
    .resume-details {grid-template-columns:1fr;gap:28px;}
    .resume-certification-list {grid-template-columns:1fr;}
    .resume-skills-list > div {grid-template-columns:1fr;gap:3px;}
  }
  @media print {
    .resume-page :global(.resume-header) {padding-bottom:16px;}
    .resume-title {font-size:13pt;}
    .resume-link {display:none;}
    .resume-company {grid-template-columns:100px minmax(0,1fr);gap:24px;padding:18px 0;}
    .resume-role-heading,.resume-company-heading {break-after:avoid;}
    .resume-bullets li {break-inside:avoid;}
    .resume-role + .resume-role {margin-top:18px;padding-top:16px;}
    .resume-bullets,.resume-intro {font-size:10pt;line-height:1.5;}
  }
</style>
