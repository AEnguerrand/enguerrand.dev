---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageIntro from "@/components/PageIntro.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import {
  ArrowRight,
  ArrowUpRight,
  BookmarkSimple,
  Brain,
  Cloud,
  Code,
  Cube,
  GitBranch,
  MagnifyingGlass,
  Package,
  PlugsConnected,
  ShieldCheck,
} from "@phosphor-icons/react";
import {
  starsDataset,
  starsGroups,
  starsDate,
  starsListHref,
  starsListName,
  starsListDescription,
} from "@/lib/stars";

const featuredSlugs = [
  "security",
  "kubernetes",
  "supply-chain-security",
  "ci-cd",
  "mcp",
  "aws",
  "dev",
  "ai-ml",
];
const featuredGroups = featuredSlugs
  .map((slug) => starsGroups.find((group) => group.slug === slug))
  .filter((group) => group !== undefined);

const signalDefinitions = [
  {
    fullName: "sigstore/cosign",
    category: "Software supply chain",
    note: "A practical standard for signing and verifying software artifacts.",
  },
  {
    fullName: "microsoft/playwright-mcp",
    category: "Agent tooling",
    note: "A useful bridge between agent workflows and real browser behaviour.",
  },
  {
    fullName: "astral-sh/uv",
    category: "Developer experience",
    note: "Fast, focused Python tooling with a simple project workflow.",
  },
];
const allRepositories = starsGroups.flatMap((group) => group.repos);
const signals = signalDefinitions.flatMap((definition) => {
  const repository = allRepositories.find((repo) => repo.full_name === definition.fullName);
  return repository ? [{
    category: definition.category,
    href: repository.html_url,
    note: definition.note,
    title: repository.full_name,
  }] : [];
});
const topicIcons = {
  security: ShieldCheck,
  kubernetes: Cube,
  "supply-chain-security": Package,
  "ci-cd": GitBranch,
  mcp: PlugsConnected,
  aws: Cloud,
  dev: Code,
  "ai-ml": Brain,
};
---

<BaseLayout title="Technical Radar" description="Three selected technical signals and a library of GitHub bookmarks organized by topic.">
  <PageIntro title="Radar" eyebrow="Selected signals and bookmarks" description={`${signals.length} selected signals, plus a broader library of GitHub bookmarks.`} art="/images/illustrations/field-guide.webp" artSize="large" class="radar-header">
    <p class="site-page-meta">
      <span>{starsGroups.length} topics</span>
      <span aria-hidden="true">·</span>
      <span>Updated {starsDate(starsDataset.generated_at)}</span>
    </p>
  </PageIntro>

  {signals.length > 0 && (
    <section class="radar-section" aria-labelledby="radar-signals-title" data-reveal data-reveal-group>
      <h2 id="radar-signals-title" class="site-section-title flex items-center gap-2" data-reveal-item><BookmarkSimple size={18} weight="duotone" className="text-primary" aria-hidden="true" />Current signals</h2>
      <div class="radar-signals mt-5">
        {signals.map((signal) => (
          <article class="radar-signal" data-reveal-item>
            <p class="site-eyebrow">{signal.category}</p>
            <h3 class="radar-signal-title">
              <a class="site-link items-start" href={signal.href} target="_blank" rel="noreferrer">
                <span class="break-all">{signal.title}</span>
                <ArrowUpRight size={18} className="motion-arrow motion-arrow-external shrink-0" aria-hidden="true" />
              </a>
            </h3>
            <p class="radar-signal-note">{signal.note}</p>
          </article>
        ))}
      </div>
    </section>
  )}

  <section class="radar-section" aria-labelledby="radar-topics-title" data-reveal>
    <SectionHeading id="radar-topics-title" title="Bookmark library" href="/github-stars/" action="All repository topics" />
    <p class="mt-2 text-sm leading-relaxed text-muted-foreground">Bookmarks for reference and further reading.</p>

    <ul class="radar-topic-list mt-5 grid sm:grid-cols-2 sm:gap-x-8">
      {featuredGroups.map((group) => {
        const TopicIcon = topicIcons[group.slug] ?? BookmarkSimple;
        return (
          <li class="border-b border-border">
            <a class="group flex min-h-16 items-center justify-between gap-5 py-4" href={starsListHref(group.slug)}>
              <span class="flex min-w-0 items-start gap-2">
                <TopicIcon size={18} className="mt-1 shrink-0 text-primary" aria-hidden="true" />
                <span class="min-w-0">
                  <span class="radar-topic-title block">{starsListName(group.name)}</span>
                  <span class="mt-1 block text-sm leading-relaxed text-muted-foreground">{starsListDescription(group)}</span>
                </span>
              </span>
              <span class="flex shrink-0 items-center gap-2 text-sm tabular-nums text-muted-foreground">
                {group.repos.length}
                <ArrowRight size={18} className="motion-arrow text-primary" aria-hidden="true" />
              </span>
            </a>
          </li>
        );
      })}
    </ul>
  </section>

  <section class="radar-search" aria-labelledby="radar-search-title" data-reveal>
    <h2 id="radar-search-title" class="site-eyebrow">Site search</h2>
    <button
      type="button"
      data-command-palette-open
      class="radar-search-trigger"
    >
      <MagnifyingGlass size={20} className="shrink-0 text-primary" aria-hidden="true" />
      <span class="min-w-0 flex-1">Search talks, projects, topics, and pages</span>
      <kbd class="hidden shrink-0 rounded-md border border-border bg-background/75 px-2 py-1 font-sans text-xs text-muted-foreground sm:inline-flex">⌘ K</kbd>
    </button>
    <a class="site-text-link radar-search-page" href="/search/">Open the search page →</a>
  </section>
</BaseLayout>

<style>
  .radar-signals {border-top:0;}
  .radar-signal {padding:24px 0;}
  .radar-signal:last-child {border-bottom:0;}
  .radar-signal > .site-eyebrow {color:hsl(var(--muted-foreground));font-weight:400;letter-spacing:0;}
  .radar-signal-title {margin-top:0;font-size:20px;font-weight:500;line-height:1.4;}
  .radar-signal-note {margin-top:0;font-size:16px;line-height:1.6;}
  .radar-topic-title {color:hsl(var(--primary));font-family:var(--font-display);font-size:20px;font-weight:500;line-height:1.4;}
  .radar-topic-list a {transition:background-color 180ms ease;}
  .radar-topic-list a:hover,.radar-topic-list a:focus-visible {background:hsl(var(--primary)/.035);}
  .radar-search-page {display:inline-flex;margin-top:12px;font-size:14px;}
  @media(max-width:600px){.radar-signal {gap:8px;padding:20px 0;}.radar-signal-note {max-width:none;}}
  @media(prefers-reduced-motion:reduce){.radar-topic-list a {transition:none;}}
</style>
