---
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  ArrowRight,
  ArrowUpRight,
  BookmarkSimple,
  Brain,
  Cloud,
  Code,
  Cube,
  GitBranch,
  MagnifyingGlass,
  Package,
  PlugsConnected,
  ShieldCheck,
} from "@phosphor-icons/react";
import {
  starsDataset,
  starsGroups,
  starsDate,
  starsListHref,
  starsListName,
} from "@/lib/stars";

const featuredSlugs = [
  "security",
  "kubernetes",
  "supply-chain-security",
  "ci-cd",
  "mcp",
  "aws",
  "dev",
  "ai-ml",
];
const featuredGroups = featuredSlugs
  .map((slug) => starsGroups.find((group) => group.slug === slug))
  .filter((group) => group !== undefined);

const signalDefinitions = [
  {
    fullName: "sigstore/cosign",
    category: "Software supply chain",
    note: "A practical standard for signing and verifying software artifacts.",
  },
  {
    fullName: "microsoft/playwright-mcp",
    category: "Agent tooling",
    note: "A useful bridge between agent workflows and real browser behaviour.",
  },
  {
    fullName: "astral-sh/uv",
    category: "Developer experience",
    note: "Fast, focused Python tooling with a simple project workflow.",
  },
];
const allRepositories = starsGroups.flatMap((group) => group.repos);
const signals = signalDefinitions.flatMap((definition) => {
  const repository = allRepositories.find((repo) => repo.full_name === definition.fullName);
  return repository ? [{
    category: definition.category,
    href: repository.html_url,
    note: definition.note,
    title: repository.full_name,
  }] : [];
});
const topicIcons = {
  security: ShieldCheck,
  kubernetes: Cube,
  "supply-chain-security": Package,
  "ci-cd": GitBranch,
  mcp: PlugsConnected,
  aws: Cloud,
  dev: Code,
  "ai-ml": Brain,
};
---

<BaseLayout title="Technical Radar" description="A curated technical library of useful repositories across security, Kubernetes, software delivery, AI, and developer tooling.">
  <header class="site-page-header radar-header" data-reveal>
    <p class="site-eyebrow">Selected technical resources</p>
    <h1 class="site-page-title">Radar</h1>
    <p class="site-page-meta">
      <span>{starsGroups.length} topics</span>
      <span aria-hidden="true">·</span>
      <span>Updated {starsDate(starsDataset.generated_at)}</span>
    </p>
  </header>

  {signals.length > 0 && (
    <section class="site-section-divider" aria-labelledby="radar-signals-title" data-reveal data-reveal-group>
      <h2 id="radar-signals-title" class="site-section-title" data-reveal-item>Current signals</h2>
      <div class="radar-signals mt-5">
        {signals.map((signal, index) => (
          <article class:list={["radar-signal motion-card", { "radar-signal-featured": index === 0 }]} data-reveal-item>
            <p class="site-eyebrow">{signal.category}</p>
            <h3 class="radar-signal-title">
              <a class="site-link items-start text-foreground" href={signal.href} target="_blank" rel="noreferrer">
                <span class="break-all">{signal.title}</span>
                <ArrowUpRight size={18} className="motion-arrow shrink-0" aria-hidden="true" />
              </a>
            </h3>
            <p class="radar-signal-note">{signal.note}</p>
          </article>
        ))}
      </div>
    </section>
  )}

  <section class="site-section-divider" aria-labelledby="radar-topics-title" data-reveal>
    <div class="flex flex-wrap items-center justify-between gap-4">
      <h2 id="radar-topics-title" class="site-section-title">Explore by topic</h2>
      <a class="site-link" href="/github-stars/">All topics <ArrowRight size={18} className="motion-arrow" aria-hidden="true" /></a>
    </div>

    <ul class="mt-5 grid border-t border-border sm:grid-cols-2 sm:gap-x-8">
      {featuredGroups.map((group) => {
        const TopicIcon = topicIcons[group.slug] ?? BookmarkSimple;
        return (
          <li class="border-b border-border">
            <a class="group flex min-h-16 items-center justify-between gap-5 py-4" href={starsListHref(group.slug)}>
              <span class="flex min-w-0 items-center gap-2 font-medium transition-colors duration-300 group-hover:text-primary">
                <TopicIcon size={18} aria-hidden="true" />
                <span>{starsListName(group.name)}</span>
              </span>
              <span class="flex shrink-0 items-center gap-2 text-sm tabular-nums text-muted-foreground">
                {group.repos.length}
                <ArrowRight size={18} className="motion-arrow text-primary" aria-hidden="true" />
              </span>
            </a>
          </li>
        );
      })}
    </ul>
  </section>

  <section class="radar-search" aria-labelledby="radar-search-title" data-reveal>
    <h2 id="radar-search-title" class="site-eyebrow">Site search</h2>
    <button
      type="button"
      data-command-palette-open
      class="radar-search-trigger"
    >
      <MagnifyingGlass size={20} className="shrink-0 text-primary" aria-hidden="true" />
      <span class="min-w-0 flex-1">Search talks, projects, topics, and pages</span>
      <kbd class="hidden shrink-0 rounded-md border border-border bg-background/75 px-2 py-1 font-sans text-xs text-muted-foreground sm:inline-flex">⌘ K</kbd>
    </button>
  </section>
</BaseLayout>
