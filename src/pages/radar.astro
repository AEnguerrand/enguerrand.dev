---
import BaseLayout from "@/layouts/BaseLayout.astro";
import starsData from "../../public/data/starred-groups.json";
const listCount = starsData.groups.filter(group => group.repos.length > 0).length;
---
<BaseLayout title="Technical Radar" description="Useful repositories and a quick search across my talks, notes, and pages.">
  <header class="site-page-header">
    <h1 class="site-page-title">Radar</h1>
    <p class="site-lead">Useful repositories and a quick way to find things on this site.</p>
  </header>
  <div class="site-list mt-0">
      <section class="site-list-row py-6">
        <h2 class="text-2xl"><a href="/github-stars/" class="hover:text-primary">GitHub Stars →</a></h2>
        <p class="mt-2 text-sm text-muted-foreground">Repositories I find useful, organized by topic. {starsData.total_repos} repos · {listCount} lists.</p>
      </section>
      <section class="site-list-row py-6">
        <h2 class="text-2xl"><a href="/search/" class="hover:text-primary">Search →</a></h2>
        <p class="mt-2 text-sm text-muted-foreground">Find a talk, post, or page.</p>
      </section>
  </div>
</BaseLayout>
