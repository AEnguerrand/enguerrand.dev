---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteSearch from "@/components/sections/SiteSearch.astro";
import { getSearchItems } from "@/lib/site-search";
import { getEntry, render } from "astro:content";

function collapseWhitespace(value: string): string {
  return value.replace(/\s+/g, " ").trim();
}

function stripMarkdown(value: string): string {
  return value
    .replace(/```[\s\S]*?```/g, " ")
    .replace(/`[^`]+`/g, " ")
    .replace(/!\[[^\]]*]\([^)]*\)/g, " ")
    .replace(/\[([^\]]+)]\([^)]*\)/g, " $1 ")
    .replace(/^>\s?/gm, " ")
    .replace(/^#{1,6}\s+/gm, " ")
    .replace(/[*_~]/g, " ");
}

function stripAstroSource(value: string): string {
  let source = value;

  if (source.startsWith("---")) {
    const frontmatterEnd = source.indexOf("\n---", 3);
    if (frontmatterEnd !== -1) {
      source = source.slice(frontmatterEnd + 4);
    }
  }

  source = source
    .replace(/^import\s.+$/gm, " ")
    .replace(/class(Name)?=\{[^}]*}/g, " ")
    .replace(/class(Name)?="[^"]*"/g, " ")
    .replace(/class(Name)?='[^']*'/g, " ")
    .replace(/href=\{[^}]*}/g, " ")
    .replace(/href="[^"]*"/g, " ")
    .replace(/href='[^']*'/g, " ")
    .replace(/<style[\s\S]*?<\/style>/g, " ")
    .replace(/<script[\s\S]*?<\/script>/g, " ")
    .replace(/<\/?[^>]+>/g, " ")
    .replace(/\{[^}]*}/g, " ");

  return source;
}

function toSearchText(value: string | undefined, maxLength = 4500): string {
  if (!value) {
    return "";
  }

  const cleaned = collapseWhitespace(stripMarkdown(value));
  if (cleaned.length <= maxLength) {
    return cleaned;
  }

  return cleaned.slice(0, maxLength);
}

const sources = import.meta.glob<string>([
  "./{index,projects,radar,github-stars,about,resume,privacy}.astro", "./talks/index.astro",
  "../components/home/ScenicHero.astro",
], { eager: true, query: "?raw", import: "default" });
const page = (await getEntry("pages", "search"))!;
const searchItems = (await getSearchItems()).map(item => {
  let content = item.content;
  if (item.kind === "page") {
    const sourcePath = item.href === "/" ? "./index.astro" : `.${item.href.replace(/\/$/, "")}.astro`;
    const source = item.href === "/talks/" ? sources["./talks/index.astro"] : sources[sourcePath];
    const hero = item.href === "/" ? sources["../components/home/ScenicHero.astro"] : "";
    content = stripAstroSource(source ?? "") + " " + stripAstroSource(hero ?? "");
  }
  return { ...item, content: toSearchText(content) };
});
const placeholder = page.data.placeholder ?? "Search this site";

const hasBodyContent = (page.body ?? "").trim().length > 0;
const renderedPage = hasBodyContent ? await render(page) : null;
const PageContent = renderedPage?.Content;
---

<BaseLayout title={page.data.title ?? "Search"} noindex={true}>
  <header class="site-page-header">
    <h1 class="site-page-title">{page.data.title ?? "Search"}</h1>
    <p class="site-lead">Find talks, projects, topics, and pages.</p>
  </header>

  <SiteSearch items={searchItems} placeholder={placeholder} />

  {hasBodyContent && PageContent && (
    <section class="site-section-divider mt-8">
      <div class="prose max-w-none">
        <PageContent />
      </div>
    </section>
  )}
</BaseLayout>
