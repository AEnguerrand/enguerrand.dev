---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectLink from "@/components/ProjectLink.astro";
import { Hero } from "@/components/sections/Hero";
import { getCollection, getEntry } from "astro:content";
import { ArrowRight } from "@phosphor-icons/react";
import { formatPostDate, getPosts, postHref } from "@/lib/posts";
import { starsGroups, starsListHref, starsListName } from "@/lib/stars";
import "@/styles/home.css";

const allTalks = await getCollection("talks");
const talks = ["meetup-owasp-france-chapter-10-2025", "kubecon-na-2024"]
  .map((id) => allTalks.find((talk) => talk.id === id))
  .filter((talk): talk is NonNullable<typeof talk> => Boolean(talk));
const homePage = await getEntry("pages", "home");
const posts = (await getPosts()).slice(0, 3);
const projects = homePage?.data.projects ?? [];
const radarTopics = ["personal", "ai-ml", "kubernetes", "supply-chain-security"]
  .map((slug) => starsGroups.find((group) => group.slug === slug))
  .filter((group): group is NonNullable<typeof group> => Boolean(group));
const eventLabels: Record<string, string> = {
  "meetup-owasp-france-chapter-10-2025": "OWASP France",
  "kubecon-na-2024": "KubeCon North America",
};
const monthYear = (date: string) => new Intl.DateTimeFormat("en-CA", {
  month: "long", year: "numeric", timeZone: "UTC",
}).format(new Date(`${date}T00:00:00Z`));
const talkFormats = (talk: typeof talks[number]) => {
  const labels = (talk.data.resources ?? []).map((resource) => resource.label.toLowerCase());
  const formats = ["Notes"];
  if (labels.some((label) => label.includes("video") || label.includes("recording"))) formats.push("Video");
  if (labels.some((label) => label.includes("slides") || label.includes("presentation"))) formats.push("Slides");
  if (labels.some((label) => label.includes("lab"))) formats.push("Lab");
  return formats;
};
---

<BaseLayout
  home
  title="Platform Security Engineer"
  pageType="ProfilePage"
  description="Enguerrand Allamel, Senior Platform Security Engineer. Talks, projects, and field notes on AI development guardrails, cloud security, Kubernetes, and developer platforms."
>
  <Hero />

  <nav class="home-work-index" aria-label="Explore my work" data-reveal data-reveal-group>
    <a href="#selected-talks" class="home-work-index-item" data-reveal-item>
      <span class="home-work-index-number" aria-hidden="true">01</span>
      <span class="home-work-index-copy"><span>Talks</span><strong>Share</strong></span>
      <ArrowRight size={24} className="motion-arrow" aria-hidden="true" />
    </a>
    <a href="#projects" class="home-work-index-item" data-reveal-item>
      <span class="home-work-index-number" aria-hidden="true">02</span>
      <span class="home-work-index-copy"><span>Projects</span><strong>Build</strong></span>
      <ArrowRight size={24} className="motion-arrow" aria-hidden="true" />
    </a>
    <a href="#explore" class="home-work-index-item" data-reveal-item>
      <span class="home-work-index-number" aria-hidden="true">03</span>
      <span class="home-work-index-copy"><span>Radar</span><strong>Explore</strong></span>
      <ArrowRight size={24} className="motion-arrow" aria-hidden="true" />
    </a>
  </nav>

  <section id="selected-talks" class="home-talks" aria-labelledby="talks-title" data-reveal data-reveal-group>
    <div class="home-section-heading" data-reveal-item>
      <div class="home-chapter-title">
        <span aria-hidden="true">01</span>
        <h2 id="talks-title">Talks</h2>
      </div>
      <a class="site-action-button site-action-button-secondary home-section-action" href="/talks/">All talks <ArrowRight size={16} className="motion-arrow" aria-hidden="true" /></a>
    </div>
    <ul class="home-list home-talk-list">
      {talks.map((talk) => (
        <li data-reveal-item>
          <a class="home-talk-link" href={`/talks/${talk.id}/`}>
            <div>
              <h3>{talk.data.displayTitle ?? talk.data.title}</h3>
              <p>{eventLabels[talk.id] ?? talk.data.event} <span aria-hidden="true">·</span> <time datetime={talk.data.date}>{monthYear(talk.data.date)}</time></p>
              <ul class="home-talk-meta">
                {talkFormats(talk).map((format) => <li>{format}</li>)}
                {(talk.data.language ?? []).map((language) => <li>{language}</li>)}
              </ul>
            </div>
            <ArrowRight size={22} className="motion-arrow" aria-hidden="true" />
          </a>
        </li>
      ))}
    </ul>
  </section>

  <div class:list={["home-content-columns", { "home-content-columns-single": posts.length === 0 }]} data-reveal data-reveal-group>
    <section id="projects" class="home-projects" aria-labelledby="projects-title">
      <div class="home-section-heading" data-reveal-item>
        <div class="home-chapter-title">
          <span aria-hidden="true">02</span>
          <h2 id="projects-title">Projects</h2>
        </div>
        <a class="site-action-button site-action-button-secondary home-section-action" href="/projects/">All projects <ArrowRight size={16} className="motion-arrow" aria-hidden="true" /></a>
      </div>
      {projects.length ? (
        <ul class="home-list home-project-list">
          {projects.map((project, index) => (
            <li class:list={["home-entry home-project-entry", { "home-project-entry-featured": index === 0 }]} data-reveal-item>
              <span class="home-project-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
              <div class="home-project-heading">
                <div>
                  <p class="home-entry-status">{project.status}</p>
                  <h3><a href={project.url}>{project.title}</a></h3>
                </div>
                {project.image && project.imageAlt && (
                  <a class="home-project-art project-art-reveal" href={project.url} aria-label={`Open ${project.title}`}>
                    <img src={project.image} alt={project.imageAlt} width="96" height="96" loading="lazy" decoding="async" />
                  </a>
                )}
              </div>
              <p>{project.description}</p>
              <ProjectLink class="home-link" href={project.url} label={project.action} />
            </li>
          ))}
        </ul>
      ) : <p class="home-empty">Project write-ups are on the way. In the meantime, you can explore my public work on GitHub.</p>}
      <a class="home-link home-archive-link" href="https://github.com/AEnguerrand?tab=repositories" data-reveal-item>Projects on GitHub <ArrowRight size={18} className="motion-arrow" aria-hidden="true" /></a>
    </section>

    {posts.length > 0 && (
      <section id="blog" class="home-blog" aria-labelledby="blog-title" data-reveal-item>
        <h2 id="blog-title">Blog</h2>
        <>
          <ul class="home-list">
            {posts.map((post) => (
              <li class="home-entry">
                <h3><a href={postHref(post.id)}>{post.data.title}</a></h3>
                {post.data.publishDate && <time datetime={post.data.publishDate}>{formatPostDate(post.data.publishDate)}</time>}
                <p>{post.data.description}</p>
              </li>
            ))}
          </ul>
          <a class="home-link home-archive-link" href="/blog/">All posts <ArrowRight size={18} className="motion-arrow" aria-hidden="true" /></a>
        </>
      </section>
    )}
  </div>

  <section id="explore" class="home-explore" aria-labelledby="explore-title" data-reveal data-reveal-group>
    <div class="home-section-heading" data-reveal-item>
      <div class="home-chapter-title">
        <span aria-hidden="true">03</span>
        <h2 id="explore-title">Explore</h2>
      </div>
      <a class="site-action-button site-action-button-secondary home-section-action" href="/radar/">Open radar <ArrowRight size={16} className="motion-arrow" aria-hidden="true" /></a>
    </div>

    <div class="home-explore-layout">
      <div class="home-current" data-reveal-item>
        <div class="home-current-heading">
          <h3>{homePage?.data.currentExploringTitle ?? "Currently exploring"}</h3>
          {homePage?.data.currentExploringUpdated && <p class="home-exploring-updated">Updated {homePage.data.currentExploringUpdated}</p>}
        </div>
        <div class="home-exploring-grid">
          {homePage?.data.currentExploring?.map((item) => (
            <article class="home-exploring-card">
              <h4>{item.title}</h4>
              <p>{item.description}</p>
            </article>
          ))}
        </div>
      </div>

      <aside class="home-radar-preview" aria-labelledby="radar-preview-title" data-reveal-item>
        <h3 id="radar-preview-title">Radar</h3>
        <ul>
          {radarTopics.map((topic) => (
            <li>
              <a href={starsListHref(topic.slug)}>
                <span>{starsListName(topic.name)}</span>
                <span>{topic.repos.length}<ArrowRight size={16} className="motion-arrow" aria-hidden="true" /></span>
              </a>
            </li>
          ))}
        </ul>
        <a class="home-link home-radar-all" href="/github-stars/">All radar topics <ArrowRight size={18} className="motion-arrow" aria-hidden="true" /></a>
      </aside>
    </div>
  </section>
</BaseLayout>
