---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectGrid from "@/components/home/ProjectGrid.astro";
import SelectedTalks from "@/components/home/SelectedTalks.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import ExplorationList from "@/components/ExplorationList.astro";
import ScenicHero from "@/components/home/ScenicHero.astro";
import { getCollection, getEntry } from "astro:content";
import { formatPostDate, getPosts, postHref } from "@/lib/posts";
import "@/styles/home.css";

const allTalks = await getCollection("talks");
const talks = ["meetup-owasp-france-chapter-10-2025", "kubecon-na-2024"]
  .map((id) => allTalks.find((talk) => talk.id === id))
  .filter((talk): talk is NonNullable<typeof talk> => Boolean(talk));
const homePage = await getEntry("pages", "home");
const posts = (await getPosts()).slice(0, 3);
const projects = homePage?.data.projects ?? [];

---

<BaseLayout
  home
  title="Platform Security Engineer"
  pageType="ProfilePage"
  description="Enguerrand Allamel, Senior Platform Security Engineer at Procurify, based in Vancouver. Talks, notes, and side projects."
>
  <ScenicHero />

  <SelectedTalks talks={talks} />

  <div class:list={["home-content-columns", { "home-content-columns-single": posts.length === 0 }]} data-reveal data-reveal-group>
    <ProjectGrid projects={projects} />
    {posts.length > 0 && (
      <section id="blog" class="home-blog" aria-labelledby="blog-title" data-reveal-item>
        <SectionHeading id="blog-title" title="Blog" href="/blog/" action="All posts" />
        <>
          <ul class="home-list">
            {posts.map((post) => (
              <li class="home-entry">
                <h3><a href={postHref(post.id)}>{post.data.title}</a></h3>
                {post.data.publishDate && <time datetime={post.data.publishDate}>{formatPostDate(post.data.publishDate)}</time>}
                <p>{post.data.description}</p>
              </li>
            ))}
          </ul>
        </>
      </section>
    )}
  </div>

  <section id="explore" class="home-explore" aria-labelledby="exploring-title" data-reveal data-reveal-group>
    <SectionHeading id="exploring-title" title={homePage?.data.currentExploringTitle ?? "Currently exploring"} />

    <div class="home-current" data-reveal-item>
      {homePage?.data.currentExploringUpdated && <p class="home-exploring-updated">Updated {homePage.data.currentExploringUpdated}</p>}
  <ExplorationList items={homePage?.data.currentExploring ?? []} />
    </div>
  </section>
</BaseLayout>
