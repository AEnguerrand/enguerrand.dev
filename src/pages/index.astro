---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Hero } from "@/components/sections/Hero";
import { getCollection, getEntry } from "astro:content";
import { ArrowRight } from "lucide-react";
import { formatPostDate, getPosts, postHref } from "@/lib/posts";
import "@/styles/home.css";

const allTalks = await getCollection("talks");
const talks = ["meetup-owasp-france-chapter-10-2025", "kubecon-na-2024"]
  .map((id) => allTalks.find((talk) => talk.id === id))
  .filter((talk): talk is NonNullable<typeof talk> => Boolean(talk));
const homePage = await getEntry("pages", "home");
const posts = (await getPosts()).slice(0, 3);
const projects = homePage?.data.projects ?? [];
const eventLabels: Record<string, string> = {
  "meetup-owasp-france-chapter-10-2025": "OWASP France",
  "kubecon-na-2024": "KubeCon North America",
};
const monthYear = (date: string) => new Intl.DateTimeFormat("en-CA", {
  month: "long", year: "numeric", timeZone: "UTC",
}).format(new Date(`${date}T00:00:00Z`));
---

<BaseLayout
  home
  title="Platform Security Engineer"
  pageType="ProfilePage"
  description="Enguerrand Allamel, Senior Platform Security Engineer. Talks, projects, and field notes on AI development guardrails, cloud security, Kubernetes, and developer platforms."
>
  <Hero />

  <section id="selected-talks" class="home-talks" aria-labelledby="talks-title">
    <div class="home-section-heading">
      <h2 id="talks-title">Talks</h2>
      <a class="home-link" href="/talks/">All talks <ArrowRight size={18} aria-hidden="true" /></a>
    </div>
    <p class="home-section-description">Recordings, slides, and practical examples.</p>
    <ul class="home-list home-talk-list">
      {talks.map((talk) => (
        <li>
          <a class="home-talk-link" href={`/talks/${talk.id}/`}>
            <div>
              <h3>{talk.data.displayTitle ?? talk.data.title}</h3>
              <p>{eventLabels[talk.id] ?? talk.data.event} <span aria-hidden="true">·</span> <time datetime={talk.data.date}>{monthYear(talk.data.date)}</time></p>
            </div>
            <ArrowRight size={22} aria-hidden="true" />
          </a>
        </li>
      ))}
    </ul>
  </section>

  <div class="home-content-columns">
    <section id="blog" aria-labelledby="blog-title">
      <h2 id="blog-title">Blog</h2>
      <p class="home-section-description">Notes on security, AI, and life in Canada.</p>
      {posts.length ? (
        <ul class="home-list">
          {posts.map((post) => (
            <li class="home-entry">
              <h3><a href={postHref(post.id)}>{post.data.title}</a></h3>
              {post.data.publishDate && <time datetime={post.data.publishDate}>{formatPostDate(post.data.publishDate)}</time>}
              <p>{post.data.description}</p>
            </li>
          ))}
        </ul>
      ) : <p class="home-empty">No posts published yet. This is where my latest notes will appear.</p>}
      <a class="home-link home-archive-link" href="/blog/">All posts <ArrowRight size={18} aria-hidden="true" /></a>
    </section>

    <section id="projects" aria-labelledby="projects-title">
      <h2 id="projects-title">Projects</h2>
      <p class="home-section-description">Things I build, test, and learn from.</p>
      {projects.length ? (
        <ul class="home-list">
          {projects.map((project) => (
            <li class="home-entry">
              <h3><a href={project.url}>{project.title}</a></h3>
              <p>{project.description}</p>
              <a class="home-link" href={project.url} aria-label={`View ${project.title}`}>View project <ArrowRight size={18} aria-hidden="true" /></a>
            </li>
          ))}
        </ul>
      ) : <p class="home-empty">Project write-ups are on the way. In the meantime, you can explore my public work on GitHub.</p>}
      <a class="home-link home-archive-link" href="https://github.com/AEnguerrand?tab=repositories">Projects on GitHub <ArrowRight size={18} aria-hidden="true" /></a>
    </section>
  </div>

  <section class="home-exploring" aria-labelledby="exploring-title">
    <h2 id="exploring-title">Currently exploring</h2>
    <div class="home-exploring-grid">
      {homePage?.data.currentExploring?.map((item) => (
        <details>
          <summary>{item.title}</summary>
          <p>{item.description}</p>
        </details>
      ))}
    </div>
  </section>
</BaseLayout>
