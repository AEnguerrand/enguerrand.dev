---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectLink from "@/components/ProjectLink.astro";
import { getEntry } from "astro:content";

const homePage = await getEntry("pages", "home");
const projects = homePage?.data.projects ?? [];

const structuredData = {
  "@type": "CollectionPage",
  "@id": "https://enguerrand.dev/projects/#collection",
  url: "https://enguerrand.dev/projects/",
  name: "Projects by Enguerrand Allamel",
  description: "Independent projects for paper archives and weather observations.",
  isPartOf: { "@id": "https://enguerrand.dev/#website" },
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: projects.length,
    itemListElement: projects.map((project, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: project.title,
      url: project.url,
    })),
  },
};
---

<BaseLayout
  title="Projects"
  description="Independent projects by Enguerrand Allamel for paper archives and weather observations."
  structuredData={structuredData}
>
  <header class="site-page-header" data-reveal>
    <h1 class="site-page-title">Projects</h1>
  </header>

  <section class="project-index" aria-labelledby="project-list-heading" data-reveal data-reveal-group>
    <h2 id="project-list-heading" class="sr-only">Project list</h2>
    <div class="project-index-list">
      {projects.map((project, index) => (
        <article class="project-index-row" data-reveal-item>
          <div class="project-index-main">
            <div class="project-index-copy">
              <p class="site-eyebrow">{project.status}</p>
              <h2><a href={project.url}>{project.title}</a></h2>
              <p>{project.description}</p>
            </div>
            {project.image && project.imageAlt && (
              <a class="project-index-art project-art-motion project-art-reveal" href={project.url} aria-label={`Open ${project.title}`}>
                <img
                  src={project.image}
                  alt={project.imageAlt}
                  width="80"
                  height="80"
                  loading={index === 0 ? "eager" : "lazy"}
                  fetchpriority={index === 0 ? "high" : undefined}
                  decoding="async"
                  class="h-full w-full object-cover"
                />
              </a>
            )}
          </div>
          <ProjectLink class="site-link project-index-link" href={project.url} label={project.action} />
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
