---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectList from "@/components/ProjectList.astro";
import PageIntro from "@/components/PageIntro.astro";
import { getEntry } from "astro:content";

const homePage = await getEntry("pages", "home");
const projects = homePage?.data.projects ?? [];

const structuredData = {
  "@type": "CollectionPage",
  "@id": "https://enguerrand.dev/projects/#collection",
  url: "https://enguerrand.dev/projects/",
  name: "Projects by Enguerrand Allamel",
  description: "Independent projects for paper archives and weather observations.",
  isPartOf: { "@id": "https://enguerrand.dev/#website" },
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: projects.length,
    itemListElement: projects.map((project, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: project.title,
      url: project.url,
    })),
  },
};
---

<BaseLayout
  title="Projects"
  description="Independent projects by Enguerrand Allamel for paper archives and weather observations."
  structuredData={structuredData}
>
  <PageIntro title="Projects" description="Software for paper archives and weather observations." />

  <section class="project-index" aria-labelledby="project-list-heading" data-reveal data-reveal-group>
    <h2 id="project-list-heading" class="sr-only">Project list</h2>
    <ProjectList projects={projects} heading="h2" eager illustrated />
  </section>
</BaseLayout>
