---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Card, CardContent } from "@/components/ui/card";
import { getCollection } from "astro:content";

const talks = (await getCollection("talks")).sort((a,b) => b.data.date.localeCompare(a.data.date));
const years = [...new Set(talks.map(talk => talk.data.date.slice(0,4)))];
const structuredData = {
  "@type": "CollectionPage",
  "@id": "https://enguerrand.dev/talks/#collection",
  url: "https://enguerrand.dev/talks/",
  name: "Cloud security talks and workshops",
  description: "Conference talks and workshops on cloud security, software supply chain protection, and reliability.",
  isPartOf: { "@id": "https://enguerrand.dev/#website" },
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: talks.length,
    itemListElement: talks.map((talk, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: talk.data.title,
      url: new URL(`/talks/${talk.id}/`, Astro.site).toString(),
    })),
  },
};
---

<BaseLayout title="Cloud & Kubernetes Security Talks" description="Conference talks and workshops on cloud security, software supply chain protection, and reliability." structuredData={structuredData}>
  <header id="overview" class="pt-6 pb-6 sm:pt-8">
    <h1 class="text-3xl font-semibold leading-tight sm:text-4xl">Talks & workshops</h1>
    <p class="mt-3 max-w-2xl text-muted-foreground">Conference sessions, meetups, and field notes on cloud and software supply chain security.</p>
  </header>
  <div id="by-year" class="space-y-7">
    {years.map(year => (
      <section aria-labelledby={`year-${year}`}>
        <h2 id={`year-${year}`} class="mb-3 text-2xl">{year}</h2>
        <Card className="border-border/70 bg-card/90 shadow-[0_14px_36px_hsl(var(--foreground)/0.05)]">
          <CardContent className="divide-y divide-border/70 px-5 py-1 sm:px-6">
            {talks.filter(talk => talk.data.date.startsWith(year)).map(talk => (
              <article class="py-5">
                <p class="mb-2 text-xs text-muted-foreground"><time datetime={talk.data.date}>{new Date(talk.data.date).toLocaleDateString("en-US", {month:"short",day:"numeric",timeZone:"UTC"})}</time>{talk.data.event && ` · ${talk.data.event}`}</p>
                <h3 class="text-xl leading-snug"><a href={`/talks/${talk.id}/`} class="hover:text-primary">{talk.data.displayTitle ?? talk.data.title} <span aria-hidden="true">→</span></a></h3>
                {talk.data.summary && <p class="mt-2 max-w-3xl text-sm leading-relaxed text-muted-foreground">{talk.data.summary}</p>}
              </article>
            ))}
          </CardContent>
        </Card>
      </section>
    ))}
  </div>
  <p id="resources" class="mt-6 text-sm text-muted-foreground">Videos, slides, and resources are on each talk page. <a id="tags" href="/topics/" class="font-semibold text-primary hover:underline">Browse topics →</a></p>
</BaseLayout>
