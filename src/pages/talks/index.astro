---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const talks = (await getCollection("talks")).sort((a,b) => b.data.date.localeCompare(a.data.date));
const years = [...new Set(talks.map(talk => talk.data.date.slice(0,4)))];
const structuredData = {
  "@type": "CollectionPage",
  "@id": "https://enguerrand.dev/talks/#collection",
  url: "https://enguerrand.dev/talks/",
  name: "Cloud security talks and workshops",
  description: "Conference talks and workshops on cloud security, software supply chain protection, and reliability.",
  isPartOf: { "@id": "https://enguerrand.dev/#website" },
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: talks.length,
    itemListElement: talks.map((talk, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: talk.data.title,
      url: new URL(`/talks/${talk.id}/`, Astro.site).toString(),
    })),
  },
};
---

<BaseLayout title="Cloud & Kubernetes Security Talks" description="Conference talks and workshops on cloud security, software supply chain protection, and reliability." structuredData={structuredData}>
  <header id="overview" class="site-page-header talks-index-header" data-reveal>
    <h1 class="site-page-title">Talks & workshops</h1>
  </header>
  <div id="by-year" class="space-y-10">
    {years.map(year => (
      <section class="site-section-divider talks-year" aria-labelledby={`year-${year}`} data-reveal data-reveal-group>
        <h2 id={`year-${year}`} class="site-section-title" data-reveal-item>{year}</h2>
        <div class="site-list">
          {talks.filter(talk => talk.data.date.startsWith(year)).map(talk => (
            <article class="site-list-row talk-index-row py-5 sm:grid sm:grid-cols-[9rem_minmax(0,1fr)] sm:gap-6" data-reveal-item>
              <p class="talk-index-meta mb-2 text-xs tabular-nums text-muted-foreground sm:mb-0"><time datetime={talk.data.date}>{new Date(talk.data.date).toLocaleDateString("en-US", {month:"short",day:"numeric",timeZone:"UTC"})}</time>{talk.data.event && ` · ${talk.data.event}`}</p>
              <div>
                <h3 class="text-xl leading-snug"><a href={`/talks/${talk.id}/`} class="hover:text-primary">{talk.data.displayTitle ?? talk.data.title} <span aria-hidden="true">→</span></a></h3>
                {talk.data.summary && <p class="mt-2 max-w-3xl text-sm leading-relaxed text-muted-foreground">{talk.data.summary}</p>}
              </div>
            </article>
          ))}
        </div>
      </section>
    ))}
  </div>
  <p id="resources" class="site-section-divider mt-10 text-sm text-muted-foreground">Videos, slides, and resources are on each talk page. <a id="tags" href="/topics/" class="font-semibold text-primary hover:underline">Browse topics →</a></p>
</BaseLayout>
