---
import HarbourLanding from "./HarbourLanding.astro";
import { EnvelopeSimple, GithubLogo, LinkedinLogo } from "@phosphor-icons/react";
interface Props { showBlog?: boolean; home?: boolean }
const { showBlog = false, home = false } = Astro.props;
const links = [{href:'/',label:'Home'}, {href:'/talks/',label:'Talks'}, {href:'/projects/',label:'Projects'}, ...(showBlog ? [{href:'/blog/',label:'Blog'}] : []), {href:'/radar/',label:'Radar'}, {href:'/search/',label:'Search'}, {href:'/privacy/',label:'Privacy'}];
---
<footer class="harbour-footer site-shell" aria-label="Site footer">
  <div class="harbour-footer-copy">
    <p>Based in Vancouver, BC, Canada</p>
    <nav class="harbour-social" aria-label="Contact links">
      <a href="mailto:hello@enguerrand.dev"><EnvelopeSimple size={16} aria-hidden="true" />Email</a>
      <a href="https://github.com/AEnguerrand"><GithubLogo size={16} aria-hidden="true" />GitHub</a>
      <a href="https://www.linkedin.com/in/enguerrandallamel/"><LinkedinLogo size={16} aria-hidden="true" />LinkedIn</a>
    </nav>
    <nav aria-label="Footer navigation">{links.map(link => <a href={link.href}>{link.label}</a>)}</nav>
  </div>
  <div class:list={["harbour-art", { compact: !home }]} aria-hidden="true">
    <div class="harbour-scene">
      <img src="/images/scenic/vancouver-harbour-map-aligned.webp" alt="" width="1672" height="941" loading="lazy" decoding="async" />
      <HarbourLanding />
    </div>
  </div>
  <div class="harbour-copyright">© {new Date().getUTCFullYear()} Enguerrand Allamel</div>
</footer>
<style>
.harbour-footer {position:relative;padding-top:64px;text-align:center;}
.harbour-footer-copy {position:relative;z-index:1;}
.harbour-footer p {margin:0 0 8px;color:hsl(var(--muted-foreground));font-size:.9375rem;}
.harbour-footer nav {display:flex;flex-wrap:wrap;justify-content:center;gap:0 24px;margin:12px auto 0;}
.harbour-footer nav a {display:inline-flex;align-items:center;min-height:44px;font-size:.875rem;color:hsl(var(--primary));}
.harbour-footer nav a:hover {color:hsl(var(--accent));text-decoration:underline;text-underline-offset:4px;}
.harbour-footer .harbour-social {margin-top:0;gap:0 24px;}
.harbour-social a {gap:7px;}
.harbour-art {position:relative;width:100vw;left:50%;transform:translateX(-50%);aspect-ratio:16/9;overflow:hidden;mask-image:linear-gradient(to bottom,transparent,black 7%);}
.harbour-art.compact {height:clamp(150px,31vw,440px);aspect-ratio:auto;}
.harbour-scene {position:absolute;inset:0;}
/* Crop the painting and the flight paths together, keeping the mountains in view. */
.compact .harbour-scene {inset:auto 0;top:30%;transform:translateY(-30%);aspect-ratio:16/9;}
.harbour-art img {width:100%;height:100%;object-fit:cover;object-position:center;}
.harbour-copyright {position:absolute;bottom:0;left:50%;transform:translateX(-50%);width:100vw;padding:32px 20px 14px;font-size:.75rem;color:#fff;background:linear-gradient(transparent,#15384be6);text-shadow:0 1px 2px #15384b;}
@media(max-width:600px){.harbour-footer{padding-top:44px;}.harbour-footer nav{gap:0 18px;margin-top:20px;}.harbour-art img{object-position:center;}}
@media print{.harbour-art{display:none;}.harbour-copyright{position:static;transform:none;width:auto;background:none;color:inherit;text-shadow:none;}}
</style>
