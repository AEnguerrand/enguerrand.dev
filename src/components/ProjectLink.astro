---
import { Github, Globe2 } from "lucide-react";

interface Props {
  href: string;
  label: string;
  class?: string;
}

const { href, label, class: className } = Astro.props;
const isGitHub = new URL(href).hostname === "github.com";
const Icon = isGitHub ? Github : Globe2;
---

<a class={className} href={href}>
  <Icon size={18} aria-hidden="true" />
  <span>{label}</span>
</a>
