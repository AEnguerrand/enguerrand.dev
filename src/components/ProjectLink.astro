---
import { GithubLogo, GlobeHemisphereWest } from "@phosphor-icons/react";

interface Props {
  href: string;
  label: string;
  class?: string;
}

const { href, label, class: className } = Astro.props;
const isGitHub = new URL(href).hostname === "github.com";
const Icon = isGitHub ? GithubLogo : GlobeHemisphereWest;
---

<a class={className} href={href}>
  <Icon size={18} weight="regular" aria-hidden="true" />
  <span>{label}</span>
</a>
