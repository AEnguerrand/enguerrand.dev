---
import type { CollectionEntry } from "astro:content";
import TalkGlobe from "./TalkGlobe.astro";
import { talkPlaces } from "@/lib/talk-globe";
interface Props { talks: CollectionEntry<"talks">[] }
const { talks } = Astro.props;
// The date row already gives the month and year. Keep the full event name on the talk page.
const eventLabel = (event: string) => event.replace(/\s*\((?:January|February|March|April|May|June|July|August|September|October|November|December) \d{4}\)$/, "");
const years = [...new Set(talks.map(talk => talk.data.date.slice(0, 4)))];
const placeFor = (talk: CollectionEntry<"talks">) => talkPlaces.find(place => place.matches(talk.data.location ?? ""));
const firstInPlace = new Map(talkPlaces.map(place => [place.id, talks.find(talk => place.matches(talk.data.location ?? ""))?.id]));
---
<div class="talk-journey">
  <img class="journey-sky" src="/images/talks/journey-sky.webp" width="1536" height="1024" alt="" decoding="async" />
  <header id="overview" class="journey-intro">
    <h1 class="site-page-title">Talks & workshops</h1>
    <p class="site-lead">Cloud security, software supply chains, and reliability.</p>
  </header>
  <div class="journey-globe">
    <TalkGlobe journey talks={talks.map(talk => ({ id: talk.id, title: talk.data.displayTitle ?? talk.data.title, location: talk.data.location, event: talk.data.event }))} />
  </div>
  <div id="by-year" class="journey-years">
    {years.map((year, yearIndex) => (
      <section class:list={["journey-year", { latest: yearIndex === 0 }]} aria-labelledby={`year-${year}`}>
        <h2 id={`year-${year}`}>{year}</h2>
        <ol>
          {talks.filter(talk => talk.data.date.startsWith(year)).map(talk => {
            const place = placeFor(talk);
            return <li>
              <article id={place && firstInPlace.get(place.id) === talk.id ? `talk-place-${place.id}` : undefined} tabindex="-1">
                <p class="journey-meta"><time datetime={talk.data.date}>{new Date(talk.data.date).toLocaleDateString("en-US", { month: "short", day: "numeric", timeZone: "UTC" })}</time> · {place?.label ?? talk.data.location} {place && <span aria-hidden="true">{place.flag}</span>}</p>
                <h3><a href={`/talks/${talk.id}/`}>{talk.data.displayTitle ?? talk.data.title}</a></h3>
                {talk.data.event && <p class="journey-event">{eventLabel(talk.data.event)}</p>}
              </article>
            </li>;
          })}
        </ol>
      </section>
    ))}
  </div>
  <p id="resources" class="journey-resources">Videos, slides, and resources are on each talk page. <a id="tags" href="/topics/">Browse topics →</a></p>
</div>
<style>
/* Keep the page within the same content grid and type scale as Home. */
.talk-journey {position:relative;display:grid;grid-template-columns:minmax(0,.95fr) minmax(0,1.05fr);column-gap:48px;margin-top:48px;isolation:isolate;}
.journey-sky {position:absolute;z-index:-1;top:0;left:50%;transform:translateX(-50%);width:100vw;max-width:none;height:650px;object-fit:cover;opacity:.22;mask-image:linear-gradient(transparent,black 18%,black 75%,transparent);pointer-events:none;}
.journey-intro {grid-column:2;grid-row:1;align-self:start;padding-top:24px;}
.journey-intro h1 {margin:0;line-height:1.08;letter-spacing:-.035em;}
.journey-intro p {margin-top:16px;max-width:42ch;font-size:1rem;line-height:1.6;color:hsl(var(--muted-foreground));}
.journey-globe {position:relative;grid-column:1;grid-row:1 / span 2;align-self:start;width:120%;max-width:600px;margin-left:-16%;}
.journey-years {display:contents;}
.journey-year {grid-column:1 / -1;margin:40px 0 0;}
.journey-year.latest {grid-column:2;grid-row:2;margin:32px 0 0;}
.journey-year h2 {display:flex;align-items:center;gap:20px;font-size:1.875rem;font-weight:500;line-height:1.2;margin:0 0 20px;}
.journey-year h2::after {content:"";height:1px;background:hsl(var(--border));flex:1;}
.journey-year ol {list-style:none;padding:0 0 0 20px;margin:0 0 0 4px;border-left:1px solid hsl(var(--border));}
.journey-year li {position:relative;padding:0 0 24px;}
.journey-year li:last-child {padding-bottom:0;}
.journey-year li::before {content:"";position:absolute;top:5px;left:-26px;width:8px;height:8px;border:2px solid hsl(var(--background));border-radius:50%;background:hsl(var(--primary));box-sizing:content-box;}
.journey-meta {margin:0 0 6px;font-size:.75rem;line-height:1.5;color:hsl(var(--muted-foreground));}
.journey-event {margin:6px 0 0;font-size:.875rem;line-height:1.5;color:hsl(var(--muted-foreground));}
.journey-year h3 {font-size:1.25rem;font-weight:500;line-height:1.35;letter-spacing:-.015em;}
.journey-year h3 a {color:hsl(var(--primary));text-decoration:none;}
.journey-year h3 a:hover {text-decoration:underline;text-underline-offset:4px;}
.journey-year article:focus-visible {outline:2px solid hsl(var(--ring));outline-offset:8px;}
.journey-resources {grid-column:1 / -1;position:relative;margin:28px 0 0;max-width:45em;font-size:.8125rem;line-height:1.6;color:hsl(var(--muted-foreground));}
.journey-resources a {color:hsl(var(--primary));white-space:nowrap;text-decoration:underline;text-underline-offset:3px;}
@media(max-width:850px){
  .talk-journey{display:block;margin-top:40px;}
  .journey-intro{padding:0;}
  .journey-globe{width:min(100%,400px);margin:16px auto 24px;}
  .journey-sky{height:600px;}
  .journey-year,.journey-year.latest{margin:32px 0 0;}
  .journey-year h2{font-size:1.75rem;}
  .journey-resources{margin:28px 0 0;}
}
@media(max-width:600px){
  .journey-intro h1{font-size:clamp(2rem,7.6vw,2.75rem);}
}
</style>
