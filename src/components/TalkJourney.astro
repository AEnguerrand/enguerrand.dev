---
import type { CollectionEntry } from "astro:content";
import TalkGlobe from "./TalkGlobe.astro";
import { talkPlaces } from "@/lib/talk-globe";
interface Props { talks: CollectionEntry<"talks">[] }
const { talks } = Astro.props;
// The date row already gives the month and year. Keep the full event name on the talk page.
const eventLabel = (event: string) => event.replace(/\s*\((?:January|February|March|April|May|June|July|August|September|October|November|December) \d{4}\)$/, "");
const years = [...new Set(talks.map(talk => talk.data.date.slice(0, 4)))];
const placeFor = (talk: CollectionEntry<"talks">) => talkPlaces.find(place => place.matches(talk.data.location ?? ""));
const firstInPlace = new Map(talkPlaces.map(place => [place.id, talks.find(talk => place.matches(talk.data.location ?? ""))?.id]));
---
<div class="talk-journey">
  <img class="journey-sky" src="/images/talks/journey-sky.webp" width="1536" height="1024" alt="" decoding="async" />
  <img class="journey-route" src="/images/talks/journey-route.webp" width="917" height="1716" alt="" decoding="async" />
  <header id="overview" class="journey-intro">
    <h1>Talks &<br /> workshops</h1>
    <p>Cloud security, software supply chains, and reliability.</p>
  </header>
  <div class="journey-globe">
    <TalkGlobe journey talks={talks.map(talk => ({ id: talk.id, title: talk.data.displayTitle ?? talk.data.title, location: talk.data.location, event: talk.data.event }))} />
  </div>
  <div id="by-year" class="journey-years">
    {years.map((year, yearIndex) => (
      <section class:list={["journey-year", { latest: yearIndex === 0 }]} aria-labelledby={`year-${year}`}>
        <h2 id={`year-${year}`}>{year}</h2>
        <ol>
          {talks.filter(talk => talk.data.date.startsWith(year)).map(talk => {
            const place = placeFor(talk);
            return <li>
              <article id={place && firstInPlace.get(place.id) === talk.id ? `talk-place-${place.id}` : undefined} tabindex="-1">
                <p class="journey-meta"><time datetime={talk.data.date}>{new Date(talk.data.date).toLocaleDateString("en-US", { month: "short", day: "numeric", timeZone: "UTC" })}</time> · {place?.label ?? talk.data.location} {place && <span aria-hidden="true">{place.flag}</span>}</p>
                <h3><a href={`/talks/${talk.id}/`}>{talk.data.displayTitle ?? talk.data.title}</a></h3>
                {talk.data.event && <p class="journey-event">{eventLabel(talk.data.event)}</p>}
              </article>
            </li>;
          })}
        </ol>
      </section>
    ))}
  </div>
  <p id="resources" class="journey-resources">Videos, slides, and resources are on each talk page. <a id="tags" href="/topics/">Browse topics →</a></p>
</div>
<style>
.talk-journey {--canvas:min(100vw,1200px);position:relative;width:var(--canvas);margin-left:calc((100% - var(--canvas))/2);isolation:isolate;}
.journey-sky {position:absolute;z-index:-2;top:-90px;left:50%;transform:translateX(-50%);width:100vw;max-width:none;height:auto;min-height:900px;object-fit:fill;opacity:.65;pointer-events:none;}
.journey-route {position:absolute;z-index:-1;top:-60px;left:0;width:100%;height:calc(var(--canvas)*1.874);pointer-events:none;}
.journey-intro {margin-left:56.7%;padding:60px 4% 0 0;min-height:calc(var(--canvas)*.495);}
.journey-intro h1 {font-size:clamp(52px,7.9vw,94px);line-height:.98;letter-spacing:-.035em;margin:0 0 24px;}
.journey-intro p {font-size:clamp(20px,2.45vw,26px);line-height:1.35;max-width:21em;}
.journey-globe {position:absolute;z-index:-1;width:85%;left:-25%;top:-55px;}
.journey-year {margin:calc(var(--canvas)*.066) 9% 0 15.5%;}
.journey-year.latest {margin:0 5% 0 59%;}
.journey-year h2 {display:flex;align-items:center;gap:16px;font-size:clamp(36px,4.6vw,52px);line-height:1.1;margin:0 0 28px;}
.journey-year h2::after {content:"";height:1px;background:hsl(var(--border));flex:1;}
.journey-year ol {list-style:none;padding:0;margin:0;}
.journey-year li {box-sizing:border-box;position:relative;min-height:calc(var(--canvas)*.14);padding:0 0 24px;}
.journey-year li::before {content:"";position:absolute;top:7px;left:-48px;width:14px;height:14px;border:3px solid hsl(var(--background));border-radius:50%;background:hsl(var(--primary));box-sizing:content-box;}
.latest li {min-height:calc(var(--canvas)*.132);}
.latest li::before {left:-38px;}
.journey-year li:last-child {min-height:0;padding-bottom:0;}
.latest li:nth-child(2) {margin-left:-23%;}
.latest li:nth-child(n+3) {margin-left:-42%;}
.journey-meta,.journey-event {font-size:clamp(15px,1.8vw,18px);line-height:1.5;color:hsl(var(--muted-foreground));}
.journey-meta {margin:0 0 4px;}
.journey-event {margin:8px 0 0;}
.journey-year h3 {font-size:clamp(22px,2.6vw,29px);line-height:1.2;letter-spacing:-.015em;}
.journey-year h3 a {color:hsl(var(--primary));text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:5px;}
.journey-year h3 a:hover {color:hsl(var(--foreground));}
.journey-year article:focus-visible {outline:2px solid hsl(var(--ring));outline-offset:8px;}
.journey-resources {position:relative;margin:28px 9% 0 15.5%;max-width:40em;font-size:.8125rem;color:hsl(var(--muted-foreground));}
.journey-resources a {color:hsl(var(--primary));white-space:nowrap;text-decoration:underline;text-underline-offset:3px;}
@media(min-width:1200px){
  .journey-intro{min-height:calc(var(--canvas)*.512);}
  .latest li:first-child{min-height:calc(var(--canvas)*.155);}
  .latest li:last-child{padding-bottom:28px;}
  .journey-year:not(.latest) li::before{left:-78px;}
  .latest li:nth-child(2)::before{left:-44px;}
  .latest li:nth-child(n+3)::before{left:-53px;}
}
@media(max-width:850px){
  .talk-journey{width:100%;margin:0;}
  .journey-intro{margin:0;padding:20px 0 0;min-height:0;}
  .journey-intro h1{font-size:clamp(42px,10vw,68px);line-height:1.04;margin-bottom:16px;}
  .journey-intro h1 br{display:none;}
  .journey-intro p{font-size:18px;max-width:25em;}
  .journey-globe{position:relative;z-index:0;left:auto;top:auto;width:min(112%,480px);margin:10px auto 20px;transform:translateX(-5%);}
  .journey-sky{height:850px;min-height:0;}
  .journey-route{display:none;}
  .journey-year,.journey-year.latest{margin:32px 0 0 22px;}
  .journey-year h2{font-size:34px;margin-bottom:24px;}
  .journey-year ol{border-left:1px solid hsl(var(--border));}
  .journey-year li,.latest li:nth-child(n){min-height:0;margin:0;padding:0 0 36px 22px;}
  .journey-year li::before{left:-8px;top:5px;width:10px;height:10px;border-width:2px;}
  .journey-year h3{font-size:23px;line-height:1.25;}
  .journey-meta,.journey-event{font-size:14px;}
  .journey-resources{margin:28px 0 0 22px;}
}
</style>
