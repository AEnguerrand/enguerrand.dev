---
interface Props {
  title: string;
  eyebrow?: string;
  description?: string;
  art?: string;
  artSize?: "small" | "large";
  class?: string;
}
const { title, eyebrow, description, art, artSize = "small", class: className } = Astro.props;
---
<header class:list={["site-page-header page-intro", { "page-intro--illustrated": art, "page-intro--large-art": art && artSize === "large" }, className]} data-reveal>
  <div class="page-intro-copy">
    {eyebrow && <p class="site-eyebrow">{eyebrow}</p>}
    <h1 class="site-page-title">{title}</h1>
    {description && <p class="site-lead">{description}</p>}
    <slot />
  </div>
  {art && <img class="page-intro-art" src={art} alt="" width="320" height="240" decoding="async" />}
</header>
<style>
  .page-intro {position:relative;}
  .page-intro-copy {min-width:0;}
  .page-intro--illustrated {display:grid;grid-template-columns:minmax(0,1fr) 180px;align-items:center;gap:32px;}
  .page-intro-art {width:180px;height:140px;object-fit:contain;transform:rotate(-2deg);transition:transform 240ms ease;}
  .page-intro--illustrated:hover .page-intro-art {transform:rotate(0);}
  .page-intro--large-art {grid-template-columns:minmax(0,1fr) 42%;}
  .page-intro--large-art .page-intro-art {width:100%;height:280px;transform:none;}
  @media(max-width:900px) and (min-width:601px){
    .page-intro--large-art {grid-template-columns:minmax(0,1fr) 34%;}
    .page-intro--large-art .page-intro-art {height:180px;}
  }
  @media(max-width:600px){
    .page-intro--illustrated {grid-template-columns:minmax(0,1fr) 72px;gap:16px;align-items:start;}
    .page-intro-art {width:72px;height:72px;margin-top:4px;}
    .page-intro--large-art {grid-template-columns:minmax(0,1fr) 104px;column-gap:16px;row-gap:0;align-items:center;}
    .page-intro--large-art .page-intro-copy {display:contents;}
    .page-intro--large-art .page-intro-copy > :global(*) {grid-column:1 / -1;}
    .page-intro--large-art .page-intro-copy > .site-eyebrow {grid-column:1;grid-row:1;}
    .page-intro--large-art .page-intro-art {grid-column:2;grid-row:1;width:104px;height:72px;margin:0;}
  }
  @media(prefers-reduced-motion:reduce){.page-intro-art {transform:none;transition:none;}.page-intro--illustrated:hover .page-intro-art {transform:none;}}
</style>
