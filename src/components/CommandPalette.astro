---
import { MagnifyingGlass, X } from "@phosphor-icons/react";
import commandPaletteUrl from "@/scripts/command-palette.js?url";

type CommandItem = {
  title: string;
  href: string;
  kind: string;
  keywords?: string;
};

const { items } = Astro.props as { items: CommandItem[] };
const initialItems = items.slice(0, 8);
---

<dialog id="site-command-dialog" class="command-dialog" aria-labelledby="command-dialog-title">
  <div class="command-dialog-shell">
    <header class="command-dialog-header">
      <MagnifyingGlass size={20} className="command-dialog-icon" aria-hidden="true" />
      <label id="command-dialog-title" class="sr-only" for="command-dialog-input">Search this site</label>
      <input
        id="command-dialog-input"
        data-command-input
        type="search"
        autocomplete="off"
        placeholder="Search talks, projects, topics, and pages"
        role="combobox"
        aria-autocomplete="list"
        aria-controls="command-dialog-results"
        aria-expanded="false"
      />
      <form method="dialog">
        <button type="submit" class="command-dialog-close" aria-label="Close search">
          <X size={18} aria-hidden="true" />
          <span class="hidden sm:inline">Esc</span>
        </button>
      </form>
    </header>

    <p class="command-dialog-status" data-command-status role="status" aria-live="polite">
      Quick links
    </p>
    <ul id="command-dialog-results" class="command-dialog-results" data-command-results role="listbox">
      {initialItems.map((item, index) => (
        <li>
          <a
            id={`command-result-${index}`}
            href={item.href}
            class="command-dialog-result"
            role="option"
            aria-selected={index === 0 ? "true" : "false"}
            data-active={index === 0 ? true : undefined}
          >
            <span>{item.title}</span>
            <span>{item.kind}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="command-dialog-help"><span>↑↓ Navigate</span><span>↵ Open</span><span>Esc Close</span></p>
  </div>
</dialog>

<script id="site-command-data" type="application/json" set:html={JSON.stringify(items).replace(/</g, "\\u003c")} />
<script is:inline type="module" src={commandPaletteUrl}></script>
