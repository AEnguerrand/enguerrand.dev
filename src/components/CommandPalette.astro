---
import { Search, X } from "lucide-react";

type CommandItem = {
  id: string;
  title: string;
  href: string;
  kind: string;
  keywords?: string;
};

const { items } = Astro.props as { items: CommandItem[] };
const initialItems = items.slice(0, 8);
---

<dialog id="site-command-dialog" class="command-dialog" aria-labelledby="command-dialog-title">
  <div class="command-dialog-shell">
    <header class="command-dialog-header">
      <Search size={20} className="command-dialog-icon" aria-hidden="true" />
      <label id="command-dialog-title" class="sr-only" for="command-dialog-input">Search this site</label>
      <input
        id="command-dialog-input"
        data-command-input
        type="search"
        autocomplete="off"
        placeholder="Search talks, projects, lists, and pages"
      />
      <form method="dialog">
        <button type="submit" class="command-dialog-close" aria-label="Close search">
          <X size={18} aria-hidden="true" />
          <span class="hidden sm:inline">Esc</span>
        </button>
      </form>
    </header>

    <p class="command-dialog-status" data-command-status role="status" aria-live="polite">
      Quick links
    </p>
    <ul class="command-dialog-results" data-command-results>
      {initialItems.map((item) => (
        <li>
          <a href={item.href} class="command-dialog-result">
            <span>{item.title}</span>
            <span>{item.kind}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="command-dialog-help"><span>↑↓ Navigate</span><span>↵ Open</span><span>Esc Close</span></p>
  </div>
</dialog>

<script is:inline define:vars={{ items }}>
  (() => {
    const dialog = document.getElementById("site-command-dialog");
    const input = dialog?.querySelector("[data-command-input]");
    const results = dialog?.querySelector("[data-command-results]");
    const status = dialog?.querySelector("[data-command-status]");

    if (!(dialog instanceof HTMLDialogElement) || !(input instanceof HTMLInputElement) || !results || !status) {
      return;
    }

    let activeIndex = 0;
    let visibleItems = items.slice(0, 8);

    const normalize = (value) => String(value ?? "")
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .toLowerCase()
      .trim();

    const score = (item, tokens) => {
      const title = normalize(item.title);
      const searchable = `${title} ${normalize(item.kind)} ${normalize(item.keywords)}`;
      let value = 0;

      for (const token of tokens) {
        if (!searchable.includes(token)) return -1;
        if (title.startsWith(token)) value += 8;
        else if (title.includes(token)) value += 5;
        else value += 1;
      }

      return value;
    };

    const setActive = (index) => {
      const links = Array.from(results.querySelectorAll("a"));
      if (!links.length) return;
      activeIndex = (index + links.length) % links.length;
      links.forEach((link, linkIndex) => link.toggleAttribute("data-active", linkIndex === activeIndex));
      links[activeIndex]?.scrollIntoView({ block: "nearest" });
    };

    const render = () => {
      const query = normalize(input.value);
      const tokens = query.split(/\s+/).filter(Boolean);
      visibleItems = tokens.length
        ? items
            .map((item) => ({ item, score: score(item, tokens) }))
            .filter((entry) => entry.score >= 0)
            .sort((a, b) => b.score - a.score || a.item.title.localeCompare(b.item.title))
            .slice(0, 10)
            .map((entry) => entry.item)
        : items.slice(0, 8);

      results.replaceChildren();
      for (const item of visibleItems) {
        const row = document.createElement("li");
        const link = document.createElement("a");
        const title = document.createElement("span");
        const kind = document.createElement("span");
        link.href = item.href;
        link.className = "command-dialog-result";
        title.textContent = item.title;
        kind.textContent = item.kind;
        link.append(title, kind);
        row.append(link);
        results.append(row);
      }

      if (!visibleItems.length) {
        const empty = document.createElement("li");
        empty.className = "command-dialog-empty";
        empty.textContent = "No results found.";
        results.append(empty);
      }

      status.textContent = query
        ? `${visibleItems.length} ${visibleItems.length === 1 ? "result" : "results"}`
        : "Quick links";
      setActive(0);
    };

    const open = () => {
      if (!dialog.open) dialog.showModal();
      input.value = "";
      render();
      window.requestAnimationFrame(() => input.focus());
    };

    document.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest("[data-command-palette-open]")) {
        event.preventDefault();
        open();
      }
    });
    window.addEventListener("site-command:open", open);
    input.addEventListener("input", render);
    input.addEventListener("keydown", (event) => {
      if (event.key === "ArrowDown") {
        event.preventDefault();
        setActive(activeIndex + 1);
      } else if (event.key === "ArrowUp") {
        event.preventDefault();
        setActive(activeIndex - 1);
      } else if (event.key === "Enter" && visibleItems.length > 0) {
        event.preventDefault();
        results.querySelectorAll("a")[activeIndex]?.click();
      }
    });
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
  })();
</script>
