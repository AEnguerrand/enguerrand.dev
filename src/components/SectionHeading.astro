---
import { ArrowRight } from "@phosphor-icons/react";

interface Props {
  id: string;
  title: string;
  href?: string;
  action?: string;
  actionVariant?: "primary" | "secondary";
}
const { id, title, href, action, actionVariant = "secondary" } = Astro.props;
---
<div class="site-section-heading">
  <h2 id={id} class="site-section-title">{title}</h2>
  {href && action && <a class:list={["site-action", "site-section-action", `site-action-${actionVariant}`]} href={href}>
    {action}<ArrowRight size={16} className="motion-arrow" aria-hidden="true" />
  </a>}
</div>
