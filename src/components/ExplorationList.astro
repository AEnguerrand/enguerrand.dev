---
interface Props { items: { title: string; description: string }[] }
const { items } = Astro.props;
---
<exploration-list class="exploration-list">
  {items.map(item => <article class="exploration-item">
    <h3>{item.title}</h3>
    <p>{item.description}</p>
  </article>)}
</exploration-list>
<style>
  .exploration-list {display:block;}
  .exploration-item {display:grid;grid-template-columns:minmax(0,1fr) minmax(0,2fr);align-items:baseline;gap:48px;padding:24px 0;}
  .exploration-item + .exploration-item {border-top:1px solid hsl(var(--border));}
  .exploration-item h3 {margin:0;font-family:var(--font-display);font-size:1.25rem;line-height:1.75rem;font-weight:500;}
  .exploration-item p {margin:0;max-width:65ch;color:hsl(var(--muted-foreground));font-size:1rem;line-height:1.5rem;}
  @media(max-width:767px) {
    .exploration-item {grid-template-columns:1fr;gap:8px;padding:20px 0;}
  }
</style>
