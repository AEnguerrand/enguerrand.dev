---
interface Props { texture?: string; fallback?: string; speed?: number; mode?: "horizon" | "sphere" }
const { texture='/images/earth/natural-earth.webp', fallback='/images/earth/natural-horizon.webp', speed=.004, mode="horizon" }=Astro.props;
---
<geographic-globe data-texture={texture} data-speed={speed} data-mode={mode}>
  <div class="earth-viewport" aria-hidden="true">
    <img class="earth-fallback" hidden={mode === "sphere"} src={fallback} alt="" width="1800" height="675" loading="lazy" decoding="async" />
    <canvas class="earth-canvas"></canvas>
    {mode === "horizon" && <span class="vancouver-marker">Vancouver</span>}
  </div>
</geographic-globe>
<script>import '../scripts/geographic-globe';</script>
<style>
geographic-globe { display:block; position:relative; width:100vw; left:50%; transform:translateX(-50%); margin-top:-16px; }
.earth-viewport { position:relative; height:37.5vw; overflow:hidden; }
.earth-fallback,.earth-canvas { position:absolute; width:100%; height:100%; inset:0; object-fit:fill; }
.earth-canvas { opacity:0; }
.vancouver-marker {position:absolute;left:50%;top:77%;z-index:2;display:flex;align-items:center;gap:7px;color:#183f56;font-size:13px;font-weight:600;white-space:nowrap;text-shadow:0 1px 3px white;pointer-events:none;}
.vancouver-marker::before {content:"";width:9px;height:9px;flex:none;border-radius:50%;background:#c9514b;border:2px solid #fff;box-shadow:0 0 0 3px #ffffff66;transform:translateX(-50%);}

.earth-viewport::after {content:"";position:absolute;inset:0;pointer-events:none;background:linear-gradient(to left,#fff4d644,transparent 36%);}
.earth-viewport {mask-image:linear-gradient(to bottom,transparent,black 25%);}
geographic-globe[data-ready] .earth-canvas { opacity:1; }
geographic-globe[data-ready] .earth-fallback { visibility:hidden; }
geographic-globe[data-mode="sphere"] {width:100%;height:100%;inset:0;transform:none;margin:0;}
geographic-globe[data-mode="sphere"] .earth-viewport {height:100%;mask-image:none;}
geographic-globe[data-mode="sphere"] .earth-viewport::after {display:none;}
geographic-globe[data-mode="sphere"] .earth-canvas {width:100%;height:100%;left:0;}
@media(max-width:600px) { .earth-viewport { height:60vw; } .earth-fallback,.earth-canvas { width:160%; max-width:none; left:-30%; } }
</style>
