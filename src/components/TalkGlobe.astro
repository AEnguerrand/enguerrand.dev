---
import { createGlobeProjection, globeFrame, talkPlaces } from "@/lib/talk-globe";

interface Props {
  talks: { id: string; title: string; location?: string }[];
}
const { talks } = Astro.props;
const frame = globeFrame(createGlobeProjection());
const groups = talkPlaces.map((place) => ({
  ...place,
  talks: talks.filter((talk) => place.matches(talk.location ?? "")),
})).filter((place) => place.talks.length);
const online = talks.filter((talk) => talk.location === "Online");
---

<talk-globe>
  <figure class="talk-globe" aria-label="Talk locations around the world">
    <svg class="talk-globe-visual" viewBox="0 0 360 360" role="group" aria-label="Interactive globe of talk locations" focusable="false">
      <defs>
        <radialGradient id="globe-light" cx="32%" cy="28%" r="72%">
          <stop offset="0%" stop-color="white" stop-opacity=".35" />
          <stop offset="65%" stop-color="white" stop-opacity="0" />
          <stop offset="100%" stop-color="hsl(201 100% 14.3%)" stop-opacity=".12" />
        </radialGradient>
      </defs>
      <circle class="globe-ocean" cx="180" cy="180" r="156" />
      <path class="globe-grid" data-globe-grid d={frame.grid} />
      <path class="globe-land" data-globe-land d={frame.land} />
      <circle cx="180" cy="180" r="156" fill="url(#globe-light)" />
      {frame.markers.filter((marker) => groups.some((group) => group.id === marker.id)).map((marker) => (
        <g class="talk-globe-marker" data-globe-marker={marker.id} transform={`translate(${marker.x} ${marker.y})`} visibility={marker.visible ? "visible" : "hidden"}>
          <circle class="globe-pin-target" r="25" />
          <circle class="globe-pin-halo" r="9" />
          <circle class="globe-pin" r="4" />
          <text class="globe-label" x="13" y="4" aria-hidden="true">{marker.label} {marker.flag}</text>
        </g>
      ))}
    </svg>
    <figcaption>
      <div class="globe-caption-row">
        <span>{talks.length} talks around the world</span>
        <button type="button" class="globe-pause" data-globe-pause hidden>Pause rotation</button>
      </div>
      <p class="globe-help" data-globe-help hidden>Drag to rotate · Select a location to see talks</p>
      <div class="globe-locations">
        {groups.map((place) => (
          <details id={`globe-place-${place.id}`} data-globe-place={place.id}>
            <summary>{place.label} <span class="globe-flag" aria-hidden="true">{place.flag}</span><span class="globe-count">{place.talks.length}</span></summary>
            <ul>
              {place.talks.map((talk) => <li><a href={`/talks/${talk.id}/`}>{talk.title}</a><span class="globe-venue">{talk.location}</span></li>)}
            </ul>
          </details>
        ))}
        {online.length > 0 && <details><summary>Online<span class="globe-count">{online.length}</span></summary><ul>{online.map((talk) => <li><a href={`/talks/${talk.id}/`}>{talk.title}</a></li>)}</ul></details>}
      </div>
    </figcaption>
  </figure>
</talk-globe>

<script>
  import "@/scripts/talk-globe";
</script>

<style>
  talk-globe, .talk-globe { display: contents; }
  .talk-globe-visual { display: block; grid-column: 2; grid-row: 1 / span 2; width: 100%; aspect-ratio: 1; height: auto; margin-inline: auto; overflow: visible; }
  .talk-globe-visual[data-interactive] { cursor: grab; touch-action: pan-y; user-select: none; }
  .talk-globe-visual[data-dragging] { cursor: grabbing; }
  .talk-globe-marker[role="button"] { cursor: pointer; outline: none; }
  .globe-pin-target { fill: transparent; }
  .talk-globe-marker:hover .globe-pin-halo,
  .talk-globe-marker:focus-visible .globe-pin-halo { stroke: hsl(var(--primary)); stroke-width: 2; }
  .talk-globe-visual[data-dragging] .talk-globe-marker { cursor: grabbing; }
  .globe-help { margin: 0 0 12px; color: hsl(var(--muted-foreground)); font-size: .75rem; }
  figcaption { grid-column: 1; grid-row: 2; align-self: start; width: min(100%, 24rem); }
  .globe-ocean { fill: hsl(var(--secondary)); stroke: hsl(var(--border)); }
  .globe-grid { fill: none; stroke: hsl(var(--foreground) / .1); stroke-width: .65; }
  .globe-land { fill: hsl(var(--primary) / .3); stroke: hsl(var(--primary) / .4); stroke-width: .5; }
  .globe-pin-halo { fill: hsl(var(--card) / .8); }
  .globe-pin { fill: hsl(var(--primary)); stroke: hsl(var(--card)); stroke-width: 1.5; }
  .globe-label { fill: hsl(var(--foreground)); font-family: var(--font-sans); font-size: 12px; font-weight: 600; paint-order: stroke; stroke: hsl(var(--background)); stroke-width: 3px; stroke-linejoin: round; }
  .globe-caption-row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 8px; color: hsl(var(--muted-foreground)); font-size: .875rem; }
  .globe-pause { min-height: 44px; color: hsl(var(--primary)); font-size: .75rem; text-decoration: underline; text-underline-offset: 4px; }
  .globe-locations { border-top: 1px solid hsl(var(--border)); }
  .globe-locations details { border-bottom: 1px solid hsl(var(--border)); }
  .globe-locations summary { min-height: 44px; padding: 12px 4px; cursor: pointer; color: hsl(var(--primary)); font-size: .875rem; }
  .globe-locations summary .globe-count { float: right; color: hsl(var(--muted-foreground)); font-variant-numeric: tabular-nums; }
  .globe-locations summary:hover { background: hsl(var(--primary) / .04); }
  .globe-locations summary:focus-visible { outline: 2px solid hsl(var(--ring)); outline-offset: 2px; }
  .globe-locations ul { display: grid; gap: 12px; padding: 0 4px 16px; list-style: none; }
  .globe-locations a { display: inline-block; padding-block: 4px; font-size: .875rem; color: hsl(var(--foreground)); text-decoration: underline; text-underline-offset: 3px; }
  .globe-venue { display: block; color: hsl(var(--muted-foreground)); font-size: .75rem; }
  @media (max-width: 767px) {
    .talk-globe-visual { grid-column: 1; grid-row: 2; width: min(100%, 20rem); }
    figcaption { grid-column: 1; grid-row: 3; width: 100%; }
  }
</style>
