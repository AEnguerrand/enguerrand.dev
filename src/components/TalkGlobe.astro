---
import GeographicGlobe from "./GeographicGlobe.astro";
import { createGlobeProjection, globeFrame, talkPlaces } from "@/lib/talk-globe";

interface Props {
  journey?: boolean;
  talks: { id: string; title: string; location?: string; event?: string }[];
}
const { talks, journey = false } = Astro.props;
const frame = globeFrame(createGlobeProjection());
const groups = talkPlaces.map((place) => ({
  ...place,
  talks: talks.filter((talk) => place.matches(talk.location ?? "")),
})).filter((place) => place.talks.length);
const online = talks.filter((talk) => talk.location === "Online");
---

<talk-globe data-journey={journey || undefined}>
  <figure class="talk-globe" aria-label="Talk locations around the world">
    <div class="talk-globe-stage">
    <GeographicGlobe mode="sphere" />
    <svg class="talk-globe-visual" viewBox="0 0 360 360" role="group" aria-label="Interactive globe of talk locations" focusable="false">
      <defs>
        <radialGradient id="talk-ocean" cx="30%" cy="25%" r="80%">
          <stop offset="0%" stop-color="#e1e9e8" />
          <stop offset="65%" stop-color="#93b1bd" />
          <stop offset="100%" stop-color="#526f7c" />
        </radialGradient>
        <filter id="talk-land-relief" x="-10%" y="-10%" width="120%" height="120%">
          <feDropShadow dx="0" dy="1" stdDeviation=".7" flood-color="#163956" flood-opacity=".35" />
        </filter>
        <radialGradient id="globe-light" cx="32%" cy="28%" r="72%">
          <stop offset="0%" stop-color="white" stop-opacity=".55" />
          <stop offset="65%" stop-color="white" stop-opacity="0" />
          <stop offset="100%" stop-color="hsl(201 100% 14.3%)" stop-opacity=".25" />
        </radialGradient>
      </defs>
      <circle class="globe-ocean" cx="180" cy="180" r="156" />
      <path class="globe-grid" data-globe-grid d={frame.grid} />
      <path class="globe-land" data-globe-land d={frame.land} />
      <circle class="globe-shade" cx="180" cy="180" r="156" fill="url(#globe-light)" />
      {frame.markers.filter((marker) => groups.some((group) => group.id === marker.id)).map((marker) => (
        <a href={journey ? `#talk-place-${marker.id}` : undefined} aria-label={journey ? `Show talks in ${marker.label}` : undefined} class="talk-globe-marker" data-globe-marker={marker.id} transform={`translate(${marker.x} ${marker.y})`} visibility={marker.visible ? "visible" : "hidden"}>
          <circle class="globe-pin-target" r="25" />
          <circle class="globe-pin-halo" r="9" />
          <circle class="globe-pin" r="4" />
          {journey && <rect class="globe-label-backplate" x={marker.x > 235 ? -(marker.label.length * 4.7 + 29) : 10} y="-8" width={marker.label.length * 4.7 + 19} height="16" rx="2" />}
          <text class="globe-label" x={marker.x > 235 ? -13 : 13} text-anchor={marker.x > 235 ? "end" : "start"} y="4" aria-hidden="true">{marker.label} {marker.flag}</text>
        </a>
      ))}
    </svg>
    </div>
    {!journey && <figcaption>
      <div class="globe-locations">
        {groups.map((place) => (
          <details id={`globe-place-${place.id}`} data-globe-place={place.id}>
            <summary>{place.label} <span class="globe-flag" aria-hidden="true">{place.flag}</span><span class="globe-count">{place.talks.length}</span></summary>
            <ul>
              {place.talks.map((talk) => <li><a href={`/talks/${talk.id}/`}>{talk.title}</a>{talk.event && <span class="globe-venue">{talk.event}</span>}</li>)}
            </ul>
          </details>
        ))}
        {online.length > 0 && <details><summary>Online<span class="globe-count">{online.length}</span></summary><ul>{online.map((talk) => <li><a href={`/talks/${talk.id}/`}>{talk.title}</a>{talk.event && <span class="globe-venue">{talk.event}</span>}</li>)}</ul></details>}
      </div>
    </figcaption>}
  </figure>
</talk-globe>

<script>
  import "@/scripts/talk-globe";
</script>

<style>
  talk-globe, .talk-globe { display: contents; }
  .talk-globe-stage {position:relative;grid-column:2;grid-row:1 / span 2;width:100%;aspect-ratio:1;}
  .talk-globe-stage :global(geographic-globe) {position:absolute;}
  .talk-globe-stage:has(:global(geographic-globe[data-ready])) :is(.globe-ocean,.globe-land,.globe-grid,.globe-shade) {opacity:0;}
  .talk-globe-visual {position:relative; display: block; width: 100%; aspect-ratio: 1; height: auto; margin-inline: auto; overflow: visible; }
  .talk-globe-visual[data-interactive] { cursor: grab; touch-action: pan-y; user-select: none; }
  .talk-globe-visual[data-dragging] { cursor: grabbing; }
  .talk-globe-marker[role="button"] { cursor: pointer; outline: none; }
  .globe-pin-target { fill: transparent; }
  .talk-globe-marker:hover .globe-pin-halo,
  .talk-globe-marker:focus-visible .globe-pin-halo { stroke: hsl(var(--primary)); stroke-width: 2; }
  .talk-globe-visual[data-dragging] .talk-globe-marker { cursor: grabbing; }
  figcaption { grid-column: 1; grid-row: 2; align-self: start; width: min(100%, 24rem); }
  .globe-ocean { fill: url(#talk-ocean); stroke: #a8c9df; stroke-width: .7; }
  .globe-grid { fill: none; stroke: #e0eff8; stroke-opacity: .25; stroke-width: .55; }
  .globe-land { fill: #82978b; stroke: #d6dfd4; stroke-width: .35; filter: url(#talk-land-relief); }
  .globe-pin-halo { fill: hsl(var(--card) / .8); }
  .globe-pin { fill: hsl(var(--primary)); stroke: hsl(var(--card)); stroke-width: 1.5; }
  .globe-label { fill: hsl(var(--foreground)); font-family: var(--font-sans); font-size: 12px; font-weight: 600; paint-order: stroke; stroke: hsl(var(--background)); stroke-width: 3px; stroke-linejoin: round; }
  .globe-locations { border-top: 1px solid hsl(var(--border)); }
  .globe-locations details { border-bottom: 1px solid hsl(var(--border)); }
  .globe-locations summary { min-height: 44px; padding: 12px 4px; cursor: pointer; color: hsl(var(--primary)); font-size: .875rem; }
  .globe-locations summary .globe-count { float: right; color: hsl(var(--muted-foreground)); font-variant-numeric: tabular-nums; }
  .globe-locations summary:hover { background: hsl(var(--primary) / .04); }
  .globe-locations summary:focus-visible { outline: 2px solid hsl(var(--ring)); outline-offset: 2px; }
  .globe-locations ul { display: grid; gap: 12px; padding: 0 4px 16px; list-style: none; }
  .globe-locations a { display: inline-block; padding-block: 4px; font-size: .875rem; color: hsl(var(--foreground)); text-decoration: underline; text-underline-offset: 3px; }
  .globe-venue { display: block; color: hsl(var(--muted-foreground)); font-size: .75rem; line-height: 1.5; }
  [data-journey] :global(geographic-globe) {filter:saturate(1.2) brightness(1.08);}
  [data-journey] .talk-globe-stage {width:100%;margin:0;}
  [data-journey] .globe-label {font-size:8.5px;stroke:none;}
  .globe-label-backplate {fill:hsl(var(--background) / .94);pointer-events:none;}
  [data-journey] .globe-pin-halo {r:5.5px;}
  [data-journey] .globe-pin {r:3px;stroke-width:1.3px;}
  [data-journey] .talk-globe-marker {cursor:pointer;outline:none;}
  @media (max-width: 850px) {
    .talk-globe-stage {grid-column:1;grid-row:2;width:min(100%,12rem);margin-inline:auto;}
    figcaption { grid-column: 1; grid-row: 3; width: 100%; }
    .globe-locations {display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 16px;}
    .globe-locations details[open] {grid-column:1 / -1;}
    .globe-label {font-size:16px;}
    [data-journey] .globe-label {font-size:12px;stroke:hsl(var(--background));stroke-width:4px;}
    .globe-label-backplate {display:none;}
  }
</style>
