---
interface NavItem {
  href: string;
  label: string;
}

interface Props {
  sectionLinks: NavItem[];
  showAllTalks?: boolean;
  showBackHome?: boolean;
}

const { sectionLinks, showAllTalks = true, showBackHome = true } = Astro.props;
---

<nav
  aria-label="Talks section navigation"
  class="talks-subnav static top-24 z-30 mb-8 border-y border-border/70 bg-background/90 py-3 backdrop-blur sm:sticky"
>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div class="flex flex-wrap items-center gap-2">
      {sectionLinks.map((item) => (
        <a
          href={item.href}
          class="talks-subnav-link inline-flex min-h-10 items-center px-1 text-xs font-semibold text-muted-foreground hover:text-foreground"
        >
          {item.label}
        </a>
      ))}
    </div>

    <div class="flex items-center gap-2 text-xs sm:text-sm">
      {showAllTalks && (
        <a
          href="/talks/"
          class="site-text-link px-1 font-medium text-foreground"
        >
          All talks
        </a>
      )}
      {showBackHome && (
        <a
          href="/"
          class="site-text-link px-1 font-medium text-foreground"
        >
          Home
        </a>
      )}
    </div>
  </div>
</nav>
