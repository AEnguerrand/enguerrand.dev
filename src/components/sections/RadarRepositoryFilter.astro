---
interface Props {
  languages: string[];
  pageNumber: number;
  slug: string;
  total: number;
}

const { languages, pageNumber, slug, total } = Astro.props;
---

<div class="radar-filter" data-radar-filter={slug} data-radar-total={total} data-radar-page={pageNumber}>
  <p class="radar-filter-fallback" data-radar-filter-fallback>Filters need JavaScript. You can browse the repositories and pages below.</p>
  <form class="radar-filter-grid" data-radar-filter-form hidden>
    <label class="radar-filter-field radar-filter-query">
      <span>Filter repositories</span>
      <input
        type="search"
        name="q"
        autocomplete="off"
        placeholder="Name, description, or topic"
        data-radar-query
      />
    </label>
    <label class="radar-filter-field radar-filter-secondary">
      <span>Language</span>
      <select name="language" data-radar-language>
        <option value="">All languages</option>
        {languages.map((language) => <option value={language}>{language}</option>)}
      </select>
    </label>
    <label class="radar-filter-field radar-filter-secondary">
      <span>Status</span>
      <select name="status" data-radar-status>
        <option value="">Any status</option>
        <option value="active">Active</option>
        <option value="archived">Archived</option>
      </select>
    </label>
    <button type="button" class="site-action site-action-secondary radar-filter-clear" data-radar-clear>
      Clear
    </button>
  </form>
  <p class="radar-filter-summary" role="status" aria-live="polite" data-radar-filter-summary>
    {`Page ${pageNumber}. ${total} ${total === 1 ? "repository" : "repositories"} in this topic.`}
  </p>
</div>

<div class="radar-filter-results" data-radar-filter-results hidden></div>

<script is:inline>
  (() => {
    const initializeRadarFilter = () => {
    window.__radarFilterController?.abort();
    const controller = new AbortController();
    window.__radarFilterController = controller;

    const root = document.querySelector("[data-radar-filter]");
    if (!(root instanceof HTMLElement)) return;
    const pathname = window.location.pathname;
    const isCurrentRoute = () => !controller.signal.aborted && root.isConnected && window.location.pathname === pathname;
    const slug = root.dataset.radarFilter ?? "";
    const total = Number(root.dataset.radarTotal ?? 0);
    const pageNumber = Number(root.dataset.radarPage ?? 1);
    const form = root?.querySelector("[data-radar-filter-form]");
    const fallback = root?.querySelector("[data-radar-filter-fallback]");
    const queryInput = root?.querySelector("[data-radar-query]");
    const languageSelect = root?.querySelector("[data-radar-language]");
    const statusSelect = root?.querySelector("[data-radar-status]");
    const clearButton = root?.querySelector("[data-radar-clear]");
    const summary = root?.querySelector("[data-radar-filter-summary]");
    const results = document.querySelector("[data-radar-filter-results]");
    const defaultList = document.querySelector("[data-radar-default]");
    const pagination = document.querySelector("[data-radar-pagination]");

    if (
      !(form instanceof HTMLFormElement) ||
      !(queryInput instanceof HTMLInputElement) ||
      !(languageSelect instanceof HTMLSelectElement) ||
      !(statusSelect instanceof HTMLSelectElement) ||
      !(clearButton instanceof HTMLButtonElement) ||
      !(summary instanceof HTMLElement) ||
      !(results instanceof HTMLElement) ||
      !(defaultList instanceof HTMLElement)
    ) return;

    document.addEventListener("astro:before-swap", () => controller.abort(), { once: true, signal: controller.signal });

    let repositoriesPromise;
    let renderVersion = 0;

    const loadRepositories = () => {
      repositoriesPromise ??= fetch("/data/starred-groups.json", { signal: controller.signal })
        .then((response) => {
          if (!response.ok) throw new Error("Repository data is unavailable.");
          return response.json();
        })
        .then((dataset) => {
          const group = dataset.groups?.find((group) => group.slug === slug);
          if (!group || !Array.isArray(group.repos)) throw new Error("Repository topic data is unavailable.");
          return group.repos;
        });
      return repositoriesPromise;
    };

    const normalize = (value) => String(value ?? "").toLocaleLowerCase().trim();

    const renderRepository = (repository) => {
      const article = document.createElement("article");
      article.className = "radar-result-row";

      const labels = document.createElement("p");
      labels.className = "radar-result-labels";
      labels.textContent = [repository.language, repository.archived ? "Archived" : "", repository.fork ? "Fork" : ""].filter(Boolean).join(" · ");
      article.append(labels);

      const heading = document.createElement("h3");
      heading.className = "radar-result-title";
      const link = document.createElement("a");
      link.className = "site-link items-start";
      link.href = repository.html_url;
      link.target = "_blank";
      link.rel = "noreferrer";
      link.textContent = repository.full_name;
      const arrow = document.createElement("span");
      arrow.setAttribute("aria-hidden", "true");
      arrow.className = "motion-arrow motion-arrow-external";
      arrow.textContent = "↗";
      link.append(arrow);
      heading.append(link);
      article.append(heading);

        const description = document.createElement("p");
        description.className = "radar-result-description";
        description.textContent = repository.description ?? "No description provided.";
        article.append(description);

      const meta = document.createElement("p");
      meta.className = "radar-result-meta";
      const number = new Intl.NumberFormat("en-US");
      const updated = new Date(repository.updated_at).toLocaleDateString("en-US", {year:"numeric", month:"short", day:"numeric", timeZone:"UTC"});
      meta.textContent = `${number.format(repository.stargazers_count)} stars · ${number.format(repository.forks_count)} forks · Updated ${updated}`;
      article.append(meta);

      if (repository.topics?.length) {
        const topics = document.createElement("p");
        topics.className = "radar-result-topics";
        topics.textContent = repository.topics.slice(0, 2).join(" · ");
        article.append(topics);
      }

      return article;
    };

    const updateUrl = (query, language, status) => {
      const url = new URL(window.location.href);
      const values = { q: query, language, status };
      for (const [key, value] of Object.entries(values)) {
        if (value) url.searchParams.set(key, value);
        else url.searchParams.delete(key);
      }
      history.replaceState(history.state, "", url);
    };

    const render = async (updateHistory = false) => {
      if (!isCurrentRoute()) return;
      const version = ++renderVersion;
      const query = normalize(queryInput.value);
      const language = languageSelect.value;
      const status = statusSelect.value;
      const isFiltering = Boolean(query || language || status);
      if (updateHistory) updateUrl(queryInput.value.trim(), language, status);

      defaultList.hidden = isFiltering;
      if (pagination instanceof HTMLElement) pagination.hidden = isFiltering;
      results.hidden = !isFiltering;

      if (!isFiltering) {
        results.replaceChildren();
        summary.textContent = `Page ${pageNumber}. ${total} ${total === 1 ? "repository" : "repositories"} in this topic.`;
        return;
      }

      summary.textContent = "Filtering repositories…";
      try {
        const repositories = await loadRepositories();
        if (!isCurrentRoute() || version !== renderVersion) return;
        const matches = repositories.filter((repository) => {
          const searchable = normalize([
            repository.full_name,
            repository.description,
            ...(repository.topics ?? []),
          ].join(" "));
          const matchesQuery = !query || query.split(/\s+/).every((token) => searchable.includes(token));
          const matchesLanguage = !language || repository.language === language;
          const matchesStatus = !status || (status === "archived" ? repository.archived : !repository.archived);
          return matchesQuery && matchesLanguage && matchesStatus;
        });

        results.replaceChildren(...matches.map(renderRepository));
        if (!matches.length) {
          const empty = document.createElement("p");
          empty.className = "radar-filter-empty";
          empty.textContent = "No repositories match these filters.";
          results.append(empty);
        }
        summary.textContent = `${matches.length} ${matches.length === 1 ? "repository" : "repositories"} found.`;
      } catch (error) {
        if (!isCurrentRoute() || version !== renderVersion) return;
        repositoriesPromise = undefined;
        if (pagination instanceof HTMLElement) pagination.hidden = false;
        summary.textContent = "Repository filtering is unavailable. The current page is still available below.";
        defaultList.hidden = false;
        results.hidden = true;
      }
    };

    const readUrl = () => {
      const parameters = new URLSearchParams(window.location.search);
      queryInput.value = parameters.get("q") ?? "";
      languageSelect.value = parameters.get("language") ?? "";
      statusSelect.value = parameters.get("status") ?? "";
    };
    readUrl();
    // History updates the URL before Astro replaces the old page. Only read this
    // document's route, and never write filter values while restoring history.
    window.addEventListener("popstate", () => {
      if (!isCurrentRoute()) return;
      readUrl();
      render();
    }, { signal: controller.signal });

    form.addEventListener("input", () => render(true), { signal: controller.signal });
    form.addEventListener("change", () => render(true), { signal: controller.signal });
    form.addEventListener("submit", (event) => event.preventDefault(), { signal: controller.signal });
    clearButton.addEventListener("click", () => {
      form.reset();
      render(true);
      queryInput.focus();
    }, { signal: controller.signal });

    form.hidden = false;
    if (fallback instanceof HTMLElement) fallback.hidden = true;
    render();
    };

    if (!window.__radarFilterPageLoadBound) {
      document.addEventListener("astro:page-load", initializeRadarFilter);
      window.__radarFilterPageLoadBound = true;
    }
    initializeRadarFilter();
  })();
</script>

<style>
  .radar-filter {padding:0 0 20px;border-bottom:0;}
  .radar-filter-grid {gap:12px;}
  .radar-filter-grid[hidden] {display:none;}
  .radar-filter-field {gap:8px;font-weight:400;}
  .radar-filter-field input,.radar-filter-field select {min-height:44px;border-radius:var(--radius-md);background:hsl(var(--background));font-weight:400;}
  .radar-filter-clear {min-height:44px;}
  .radar-filter-fallback {max-width:65ch;color:hsl(var(--muted-foreground));font-size:14px;line-height:1.6;}
  .radar-filter-results {grid-template-columns:repeat(2,minmax(0,1fr));column-gap:40px;margin-top:8px;border-top:0;}
  .radar-filter-results :global(.radar-result-row),.radar-filter-results :global(.radar-result-row:nth-child(even)) {display:flex;min-width:0;flex-direction:column;padding:24px 0;border-left:0;}
  .radar-filter-results :global(.radar-result-title) {margin-top:8px;font-size:20px;font-weight:500;line-height:1.4;}
  .radar-filter-results :global(.radar-result-title a) {font-family:var(--font-display);font-size:inherit;font-weight:inherit;overflow-wrap:anywhere;}
  .radar-filter-results :global(.radar-result-description) {margin-top:8px;color:hsl(var(--muted-foreground));font-size:16px;line-height:1.6;}
  .radar-filter-results :global(.radar-result-labels),.radar-filter-results :global(.radar-result-meta),.radar-filter-results :global(.radar-result-topics) {color:hsl(var(--muted-foreground));font-size:12px;line-height:1.6;overflow-wrap:anywhere;}
  .radar-filter-results :global(.radar-result-meta) {margin-top:auto;padding-top:16px;font-variant-numeric:tabular-nums;}
  .radar-filter-results :global(.radar-result-topics) {margin-top:8px;}
  @media(max-width:767px) {
    .radar-filter-results {grid-template-columns:1fr;}
    .radar-filter-grid {grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;}
    .radar-filter-query {grid-column:1 / -1;}
    .radar-filter-clear {width:fit-content;}
  }
</style>
