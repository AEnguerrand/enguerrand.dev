---
interface Props {
  embedUrl: string;
  sourceUrl: string;
  title: string;
}
const { embedUrl, sourceUrl, title } = Astro.props;
const provider = new URL(embedUrl).hostname.includes("vimeo.com") ? "Vimeo" : "YouTube";
---

<talk-video data-embed-url={embedUrl} data-video-title={`Video recording for ${title}`}>
  <div class="video-frame" data-video-frame>
    <div class="video-placeholder">
      <button type="button" class="site-action site-action-primary" data-video-load aria-describedby="video-load-note" hidden>
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
        Load video
      </button>
      <p id="video-load-note" data-video-note hidden>The {provider} player loads only when you select “Load video”.</p>
      <noscript><p class="video-source"><a href={sourceUrl} class="site-text-link">Watch on {provider} ↗</a></p></noscript>
    </div>
  </div>
</talk-video>

<script>
  class TalkVideo extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector<HTMLButtonElement>("[data-video-load]");
      if (!button) return;
      const note = this.querySelector<HTMLElement>("[data-video-note]");
      if (note) note.hidden = false;
      button.hidden = false;
      button.addEventListener("click", this.loadVideo);
    }

    disconnectedCallback() {
      this.querySelector("[data-video-load]")?.removeEventListener("click", this.loadVideo);
    }

    private loadVideo = () => {
      const container = this.querySelector<HTMLElement>("[data-video-frame]");
      const embedUrl = this.dataset.embedUrl;
      if (!container || !embedUrl || container.querySelector("iframe")) return;

      const iframe = document.createElement("iframe");
      iframe.src = embedUrl;
      iframe.title = this.dataset.videoTitle ?? "Talk video recording";
      iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = "strict-origin-when-cross-origin";
      container.replaceChildren(iframe);
      iframe.focus();
    };
  }

  if (!customElements.get("talk-video")) customElements.define("talk-video", TalkVideo);
</script>

<style>
  talk-video {display:block;margin-top:20px;}
  .video-frame {display:grid;grid-template-columns:minmax(0,1fr);overflow:hidden;border:1px solid hsl(var(--border) / .7);border-radius:12px;background:hsl(var(--muted) / .45);}
  /* The spacer sets a 16:9 minimum height. The placeholder can grow with its text. */
  .video-frame::before {content:"";grid-area:1 / 1;padding-top:56.25%;pointer-events:none;}
  .video-placeholder {grid-area:1 / 1;display:flex;min-width:0;min-height:0;flex-direction:column;align-items:center;justify-content:center;gap:16px;padding:24px;text-align:center;}
  .video-placeholder button {min-height:44px;gap:8px;}
  .video-placeholder button[hidden] {display:none;}
  .video-placeholder p {max-width:38ch;color:hsl(var(--muted-foreground));font-size:.875rem;line-height:1.6;}
  .video-frame :global(iframe) {grid-area:1 / 1;width:100%;height:auto;aspect-ratio:16 / 9;border:0;}
  .video-frame :global(iframe:focus-visible) {outline:2px solid hsl(var(--ring));outline-offset:-4px;}
  .video-source a {display:inline-flex;align-items:center;min-height:44px;}
</style>
