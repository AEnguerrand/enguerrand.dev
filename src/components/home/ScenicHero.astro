---
import ForestWind from "./ForestWind.astro";
import { EnvelopeSimple, GithubLogo, LinkedinLogo } from '@phosphor-icons/react';
interface Props { landscape?: string }
const { landscape = '/images/scenic/forest.webp' } = Astro.props;
---
<section class="scenic-hero" aria-label="Introduction" data-hero-motion>
  <ForestWind landscape={landscape} />
  <div class="scenic-hero-copy" data-hero-item>
    <h1>Hi, I'm <span class="home-name">Enguerrand.</span></h1>
    <p class="scenic-hero-statement">I build secure and reliable cloud platforms.</p>
    <p class="scenic-hero-description">I'm a Senior Platform Security Engineer at Procurify, based in Vancouver. Here I share talks, notes, and side projects.</p>
    <div id="contact" class="home-contact" aria-label="Contact links">
      <a class="site-action site-action-primary" href="mailto:hello@enguerrand.dev"><EnvelopeSimple size={18} aria-hidden="true" />hello@enguerrand.dev</a>
      <a class="site-action site-action-secondary" href="https://github.com/AEnguerrand"><GithubLogo size={18} aria-hidden="true" />GitHub</a>
      <a class="site-action site-action-secondary" href="https://www.linkedin.com/in/enguerrandallamel/"><LinkedinLogo size={18} aria-hidden="true" />LinkedIn</a>
    </div>
  </div>
</section>
<style>
.scenic-hero { position: relative; isolation: isolate; min-height: 560px; padding-top: 76px; }
.scenic-hero-copy { position: relative; z-index: 2; max-width: 66%; }
.scenic-hero h1 { font-size: clamp(2.75rem, 4.7vw, 4rem); line-height: 1.08; font-weight: 600; letter-spacing: -.035em; }
.scenic-hero .home-name { color: hsl(var(--primary)); }
.scenic-hero-statement { margin-top: 20px; max-width: 30ch; font-size: clamp(1.5rem, 2.5vw, 1.9rem); line-height: 1.3; letter-spacing: -.025em; }
.scenic-hero-description { margin-top: 16px; max-width: 52ch; color: hsl(var(--muted-foreground)); font-size: 1rem; line-height: 1.6; }
@media(max-width:900px) {
  .scenic-hero { min-height:520px; padding-top:48px; }
  .scenic-hero-copy { max-width:82%; }
}
@media(max-width:600px) {
  .scenic-hero { min-height:560px; padding-top:40px; }
  .scenic-hero-copy { max-width:100%; }
  .scenic-hero h1 { font-size:clamp(2rem, 7.6vw, 2.75rem); }
  .scenic-hero-description { max-width:42ch; }
  .scenic-hero .home-contact { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:8px; margin-top:16px; }
  .scenic-hero .home-contact a { justify-content:center; min-height:44px; }
  .scenic-hero .home-contact a:first-child { grid-column:1 / -1; }
}
</style>
