{
  "name": "aenguerrand-astro",
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy:cf": "npm run build && npx wrangler deploy",
    "stars:import-ui": "uv run scripts/import_starred_lists_from_ui.py",
    "stars:sync": "uv run scripts/sync_starred_lists.py",
    "stars:refresh": "npm run stars:import-ui && npm run stars:sync",
    "check:site": "astro sync && tsc -p tsconfig.site.json",
    "test:site": "node --test scripts/posts.test.mjs scripts/site-output.test.mjs scripts/globe-drag.test.mjs scripts/publication.test.mjs scripts/review-evidence.test.mjs",
    "review:site": "node scripts/review-site.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.3.1",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/react": "^6.0.2",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.0",
    "astro": "^7.4.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "@types/d3-geo": "^3.1.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/topojson-client": "^3.1.5",
    "autoprefixer": "^10.4.20",
    "parse5": "^7.3.0",
    "playwright": "1.64.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss-selector-parser": "6.1.5"
  }
}
